<mxfile host="dsh" agent="draw-the-plugins.py"><diagram id="plugins" name="Плагины"><mxGraphModel dx="0" dy="0" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1700" pageHeight="1000" math="0" shadow="0"><root><mxCell id="0" /><mxCell id="1" parent="0" /><mxCell id="h" value="ПЛАГИНЫ DSH" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#DAE8FC;strokeColor=#6C8EBF;fontSize=16;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="70" y="30" width="480" height="48" as="geometry" /></mxCell><mxCell id="shape" value="ОБЩАЯ ФОРМА: у плагина ДВЕ СТОРОНЫ" style="text;html=1;align=left;fontSize=13;fontStyle=1;strokeColor=none;fillColor=none;" vertex="1" parent="1"><mxGeometry x="70" y="100" width="480" height="26" as="geometry" /></mxCell><mxCell id="f0" value="&lt;b&gt;lib/index.js&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#444444&quot; style=&quot;font-size:11px&quot;&gt;серверная сторона: то, что живёт в процессе DSH&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#D5E8D4;strokeColor=#82B366;align=left;spacingLeft=10;fontSize=12;" vertex="1" parent="1"><mxGeometry x="70" y="140" width="480" height="56" as="geometry" /></mxCell><mxCell id="f1" value="&lt;b&gt;lib/client.js&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#444444&quot; style=&quot;font-size:11px&quot;&gt;клиентская сторона: кнопка, панель, то, что видно на странице&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#DAE8FC;strokeColor=#6C8EBF;align=left;spacingLeft=10;fontSize=12;" vertex="1" parent="1"><mxGeometry x="70" y="206" width="480" height="56" as="geometry" /></mxCell><mxCell id="f2" value="&lt;b&gt;package.json&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#444444&quot; style=&quot;font-size:11px&quot;&gt;объявляет обе стороны — без него плагин не смонтируется&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F5F5F5;strokeColor=#666666;align=left;spacingLeft=10;fontSize=12;" vertex="1" parent="1"><mxGeometry x="70" y="272" width="480" height="56" as="geometry" /></mxCell><mxCell id="p0" value="&lt;b&gt;Русский язык для веб-интерфейса DSH&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#444444&quot; style=&quot;font-size:11px&quot;&gt;регистрирует локаль и словари для всех пространств имён&lt;/font&gt;&lt;br&gt;&lt;font color=&quot;#999999&quot; style=&quot;font-size:9px&quot;&gt;locale-ru · client.js, index.js&lt;/font&gt;&lt;br&gt;&lt;font color=&quot;#AAAAAA&quot; style=&quot;font-size:8px&quot;&gt;Russian language pack for the DSH Web GUI: registers the ru locale and Russian dictionaries for every shipped &lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#DAE8FC;strokeColor=#6C8EBF;align=left;spacingLeft=10;fontSize=12;" vertex="1" parent="1"><mxGeometry x="70" y="380" width="900" height="86" as="geometry" /></mxCell><mxCell id="p1" value="&lt;b&gt;Показывает установленные моды и включает/выключает их&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#444444&quot; style=&quot;font-size:11px&quot;&gt;без перезапуска: панель в Настройках&lt;/font&gt;&lt;br&gt;&lt;font color=&quot;#999999&quot; style=&quot;font-size:9px&quot;&gt;mod-manager · client.js, index.js&lt;/font&gt;&lt;br&gt;&lt;font color=&quot;#AAAAAA&quot; style=&quot;font-size:8px&quot;&gt;DSH plugin: a Settings panel that lists installed mods, shows whether each is served to the running page, and &lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E1D5E7;strokeColor=#9673A6;align=left;spacingLeft=10;fontSize=12;" vertex="1" parent="1"><mxGeometry x="70" y="482" width="900" height="86" as="geometry" /></mxCell><mxCell id="p2" value="&lt;b&gt;Показывает скиллы, которые видит харнесс, и ставит любой на паузу&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#444444&quot; style=&quot;font-size:11px&quot;&gt;пауза = переименование файла; удаления нет&lt;/font&gt;&lt;br&gt;&lt;font color=&quot;#999999&quot; style=&quot;font-size:9px&quot;&gt;skill-manager · client.js, index.js&lt;/font&gt;&lt;br&gt;&lt;font color=&quot;#AAAAAA&quot; style=&quot;font-size:8px&quot;&gt;DSH plugin: a Settings panel that lists the skills this Harness resolves, with each one&#x27;s description, and pau&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E1D5E7;strokeColor=#9673A6;align=left;spacingLeft=10;fontSize=12;" vertex="1" parent="1"><mxGeometry x="70" y="584" width="900" height="86" as="geometry" /></mxCell><mxCell id="p3" value="&lt;b&gt;Доска поиска скиллов: что искать, поиск, суд, запись в каталог&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#444444&quot; style=&quot;font-size:11px&quot;&gt;с приговором, оценкой и ссылкой на источник&lt;/font&gt;&lt;br&gt;&lt;font color=&quot;#999999&quot; style=&quot;font-size:9px&quot;&gt;skill-scout · client.js, index.js&lt;/font&gt;&lt;br&gt;&lt;font color=&quot;#AAAAAA&quot; style=&quot;font-size:8px&quot;&gt;DSH plugin: a Settings panel that is a board for finding skills — anyone writes what to look for, an agent run&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFE6CC;strokeColor=#D79B00;align=left;spacingLeft=10;fontSize=12;" vertex="1" parent="1"><mxGeometry x="70" y="686" width="900" height="86" as="geometry" /></mxCell><mxCell id="p4" value="&lt;b&gt;Кнопка в шапке чата: показать живой системный промпт и подменить его&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#444444&quot; style=&quot;font-size:11px&quot;&gt;применяется без перезапуска&lt;/font&gt;&lt;br&gt;&lt;font color=&quot;#999999&quot; style=&quot;font-size:9px&quot;&gt;system-prompt-mod · client.js, index.js&lt;/font&gt;&lt;br&gt;&lt;font color=&quot;#AAAAAA&quot; style=&quot;font-size:8px&quot;&gt;Dual-face DSH plugin: a chat-header button that shows the live system prompt, edits it, and applies an overrid&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#D5E8D4;strokeColor=#82B366;align=left;spacingLeft=10;fontSize=12;" vertex="1" parent="1"><mxGeometry x="70" y="788" width="900" height="86" as="geometry" /></mxCell><mxCell id="l0" value="ЧТО ЭТО ЗА СХЕМА" style="text;html=1;align=left;verticalAlign=middle;fontSize=12;fontStyle=1;strokeColor=none;fillColor=none;" vertex="1" parent="1"><mxGeometry x="1010" y="140" width="660" height="26" as="geometry" /></mxCell><mxCell id="l1" value="Пять плагинов DSH: что каждый делает и какая форма у них общая." style="text;html=1;align=left;verticalAlign=middle;fontSize=12;fontStyle=0;strokeColor=none;fillColor=none;" vertex="1" parent="1"><mxGeometry x="1010" y="170" width="660" height="26" as="geometry" /></mxCell><mxCell id="l2" value="Это НЕ схема скиллов (family.drawio) и НЕ ворота регламента (gates.drawio)." style="text;html=1;align=left;verticalAlign=middle;fontSize=12;fontStyle=0;strokeColor=none;fillColor=none;" vertex="1" parent="1"><mxGeometry x="1010" y="200" width="660" height="26" as="geometry" /></mxCell><mxCell id="l3" value="" style="text;html=1;align=left;verticalAlign=middle;fontSize=12;fontStyle=0;strokeColor=none;fillColor=none;" vertex="1" parent="1"><mxGeometry x="1010" y="230" width="660" height="26" as="geometry" /></mxCell><mxCell id="l4" value="КАК ЧИТАТЬ" style="text;html=1;align=left;verticalAlign=middle;fontSize=12;fontStyle=1;strokeColor=none;fillColor=none;" vertex="1" parent="1"><mxGeometry x="1010" y="260" width="660" height="26" as="geometry" /></mxCell><mxCell id="l5" value="Сверху — общая форма плагина: две стороны и манифест, который их объявляет." style="text;html=1;align=left;verticalAlign=middle;fontSize=12;fontStyle=0;strokeColor=none;fillColor=none;" vertex="1" parent="1"><mxGeometry x="1010" y="290" width="660" height="26" as="geometry" /></mxCell><mxCell id="l6" value="Ниже — каждый плагин: что он даёт человеку, как называется, из чего состоит." style="text;html=1;align=left;verticalAlign=middle;fontSize=12;fontStyle=0;strokeColor=none;fillColor=none;" vertex="1" parent="1"><mxGeometry x="1010" y="320" width="660" height="26" as="geometry" /></mxCell><mxCell id="l7" value="" style="text;html=1;align=left;verticalAlign=middle;fontSize=12;fontStyle=0;strokeColor=none;fillColor=none;" vertex="1" parent="1"><mxGeometry x="1010" y="350" width="660" height="26" as="geometry" /></mxCell><mxCell id="l8" value="ЧТО У НИХ ОБЩЕГО" style="text;html=1;align=left;verticalAlign=middle;fontSize=12;fontStyle=1;strokeColor=none;fillColor=none;" vertex="1" parent="1"><mxGeometry x="1010" y="380" width="660" height="26" as="geometry" /></mxCell><mxCell id="l9" value="Все пять монтируются БЕЗ перезапуска и все показываются в Настройках." style="text;html=1;align=left;verticalAlign=middle;fontSize=12;fontStyle=0;strokeColor=none;fillColor=none;" vertex="1" parent="1"><mxGeometry x="1010" y="410" width="660" height="26" as="geometry" /></mxCell><mxCell id="l10" value="Три из них — панели одного вида: список, состояние и переключатель." style="text;html=1;align=left;verticalAlign=middle;fontSize=12;fontStyle=0;strokeColor=none;fillColor=none;" vertex="1" parent="1"><mxGeometry x="1010" y="440" width="660" height="26" as="geometry" /></mxCell></root></mxGraphModel></diagram></mxfile>