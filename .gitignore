# Dependencies and links — never commit these.
node_modules/
package-lock.json
pnpm-lock.yaml

# Personal data: a DSH home backup holds settings.yaml and the prompt override.
mod-backups/
backup/
*.credentials.yaml
.credentials.yaml
settings.yaml
system-prompt-mod.json

# Access tokens, wherever someone happens to save them.
#
# A token file dropped into this directory was committed once and only stopped by
# GitHub's push protection, which is a backstop, not a plan. These rules are the
# plan: pushing needs a credential, so the credential tends to end up near the
# thing being pushed.
*token*
*token
token*
*.token
.env
.env.*
secrets.*

# Verification harness artefacts.
_edge-profile*/
_testhome*/
shots/
*.log
locale-en.json

# Editor and OS noise.
.vscode/
.idea/
Thumbs.db
Desktop.ini
.DS_Store

# Python bytecode. A skill is plain text; a compiled cache is neither readable
# nor part of the work, and it was committed here once by accident.
__pycache__/
*.pyc
*.pyo