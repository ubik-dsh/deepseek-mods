<mxfile host="dsh" agent="draw-a-skill-flow.py"><diagram id="create-a-skill" name="Как написать скилл"><mxGraphModel dx="0" dy="0" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1400" pageHeight="1400" math="0" shadow="0"><root><mxCell id="0" /><mxCell id="1" parent="0" /><mxCell id="head" value="Как написать скилл" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#DAE8FC;strokeColor=#6C8EBF;fontSize=16;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="70" y="30" width="560" height="48" as="geometry" /></mxCell><mxCell id="s0" value="&lt;b&gt;Сначала выяснить, не существует ли уже&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#444444&quot; style=&quot;font-size:11px&quot;&gt;чужой испытанный скилл дешевле своего&lt;/font&gt;&lt;br&gt;&lt;font color=&quot;#999999&quot; style=&quot;font-size:9px&quot;&gt;First, find out whether it already exists&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#DAE8FC;strokeColor=#6C8EBF;align=left;spacingLeft=10;fontSize=12;" vertex="1" parent="1"><mxGeometry x="70" y="110" width="560" height="72" as="geometry" /></mxCell><mxCell id="a0" style="endArrow=classic;html=1;strokeColor=#6C8EBF;strokeWidth=2;rounded=0;edgeStyle=orthogonalEdgeStyle;" edge="1" parent="1" source="head" target="s0"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="s1" value="&lt;b&gt;Решить, что это за скилл&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#444444&quot; style=&quot;font-size:11px&quot;&gt;процедура, справочник или регламент&lt;/font&gt;&lt;br&gt;&lt;font color=&quot;#999999&quot; style=&quot;font-size:9px&quot;&gt;First, decide what kind of skill this is&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFE6CC;strokeColor=#D79B00;align=left;spacingLeft=10;fontSize=12;" vertex="1" parent="1"><mxGeometry x="70" y="202" width="560" height="72" as="geometry" /></mxCell><mxCell id="a1" style="endArrow=classic;html=1;strokeColor=#6C8EBF;strokeWidth=2;rounded=0;edgeStyle=orthogonalEdgeStyle;" edge="1" parent="1" source="s0" target="s1"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="s2" value="&lt;b&gt;Куда положить и как назвать файл&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#444444&quot; style=&quot;font-size:11px&quot;&gt;семь корней, которые харнесс обходит&lt;/font&gt;&lt;br&gt;&lt;font color=&quot;#999999&quot; style=&quot;font-size:9px&quot;&gt;Where it goes, and what the file is called&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E1D5E7;strokeColor=#9673A6;align=left;spacingLeft=10;fontSize=12;" vertex="1" parent="1"><mxGeometry x="70" y="294" width="560" height="72" as="geometry" /></mxCell><mxCell id="a2" style="endArrow=classic;html=1;strokeColor=#6C8EBF;strokeWidth=2;rounded=0;edgeStyle=orthogonalEdgeStyle;" edge="1" parent="1" source="s1" target="s2"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="s3" value="&lt;b&gt;Шапка файла&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#444444&quot; style=&quot;font-size:11px&quot;&gt;двоеточие внутри значения молча снимает скилл с регистрации&lt;/font&gt;&lt;br&gt;&lt;font color=&quot;#999999&quot; style=&quot;font-size:9px&quot;&gt;Frontmatter&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#D5E8D4;strokeColor=#82B366;align=left;spacingLeft=10;fontSize=12;" vertex="1" parent="1"><mxGeometry x="70" y="386" width="560" height="72" as="geometry" /></mxCell><mxCell id="a3" style="endArrow=classic;html=1;strokeColor=#6C8EBF;strokeWidth=2;rounded=0;edgeStyle=orthogonalEdgeStyle;" edge="1" parent="1" source="s2" target="s3"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="s4" value="&lt;b&gt;Описание — вся поверхность совпадения&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#444444&quot; style=&quot;font-size:11px&quot;&gt;по нему скилл находят или не находят&lt;/font&gt;&lt;br&gt;&lt;font color=&quot;#999999&quot; style=&quot;font-size:9px&quot;&gt;The description is the whole matching surface&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F5F5F5;strokeColor=#666666;align=left;spacingLeft=10;fontSize=12;" vertex="1" parent="1"><mxGeometry x="70" y="478" width="560" height="72" as="geometry" /></mxCell><mxCell id="a4" style="endArrow=classic;html=1;strokeColor=#6C8EBF;strokeWidth=2;rounded=0;edgeStyle=orthogonalEdgeStyle;" edge="1" parent="1" source="s3" target="s4"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="s5" value="&lt;b&gt;Семья как граф, и чего стоит указатель&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#444444&quot; style=&quot;font-size:11px&quot;&gt;метки на рёбрах: объявлено, упомянуто, неоднозначно&lt;/font&gt;&lt;br&gt;&lt;font color=&quot;#999999&quot; style=&quot;font-size:9px&quot;&gt;The family as a graph, and what a sign is worth&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F5F5F5;strokeColor=#666666;align=left;spacingLeft=10;fontSize=12;" vertex="1" parent="1"><mxGeometry x="70" y="570" width="560" height="72" as="geometry" /></mxCell><mxCell id="a5" style="endArrow=classic;html=1;strokeColor=#6C8EBF;strokeWidth=2;rounded=0;edgeStyle=orthogonalEdgeStyle;" edge="1" parent="1" source="s4" target="s5"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="s6" value="&lt;b&gt;Писать инструкции, а не документацию&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#444444&quot; style=&quot;font-size:11px&quot;&gt;агент исполняет, а не читает для интереса&lt;/font&gt;&lt;br&gt;&lt;font color=&quot;#999999&quot; style=&quot;font-size:9px&quot;&gt;Write instructions, not documentation&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F5F5F5;strokeColor=#666666;align=left;spacingLeft=10;fontSize=12;" vertex="1" parent="1"><mxGeometry x="70" y="662" width="560" height="72" as="geometry" /></mxCell><mxCell id="a6" style="endArrow=classic;html=1;strokeColor=#6C8EBF;strokeWidth=2;rounded=0;edgeStyle=orthogonalEdgeStyle;" edge="1" parent="1" source="s5" target="s6"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="s7" value="&lt;b&gt;Тело — как процедура&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#444444&quot; style=&quot;font-size:11px&quot;&gt;шаги, а не рассказ о шагах&lt;/font&gt;&lt;br&gt;&lt;font color=&quot;#999999&quot; style=&quot;font-size:9px&quot;&gt;Write the body as a procedure&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F5F5F5;strokeColor=#666666;align=left;spacingLeft=10;fontSize=12;" vertex="1" parent="1"><mxGeometry x="70" y="754" width="560" height="72" as="geometry" /></mxCell><mxCell id="a7" style="endArrow=classic;html=1;strokeColor=#6C8EBF;strokeWidth=2;rounded=0;edgeStyle=orthogonalEdgeStyle;" edge="1" parent="1" source="s6" target="s7"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="s8" value="&lt;b&gt;Доказать до того, как закончить&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#444444&quot; style=&quot;font-size:11px&quot;&gt;прогон на настоящем случае, а не на выдуманном&lt;/font&gt;&lt;br&gt;&lt;font color=&quot;#999999&quot; style=&quot;font-size:9px&quot;&gt;Prove it before you finish&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F5F5F5;strokeColor=#666666;align=left;spacingLeft=10;fontSize=12;" vertex="1" parent="1"><mxGeometry x="70" y="846" width="560" height="72" as="geometry" /></mxCell><mxCell id="a8" style="endArrow=classic;html=1;strokeColor=#6C8EBF;strokeWidth=2;rounded=0;edgeStyle=orthogonalEdgeStyle;" edge="1" parent="1" source="s7" target="s8"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="s9" value="&lt;b&gt;Прежде чем назвать готовым&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#444444&quot; style=&quot;font-size:11px&quot;&gt;независимый агент читает скилл — ворота G4&lt;/font&gt;&lt;br&gt;&lt;font color=&quot;#999999&quot; style=&quot;font-size:9px&quot;&gt;Before you call it done&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F5F5F5;strokeColor=#666666;align=left;spacingLeft=10;fontSize=12;" vertex="1" parent="1"><mxGeometry x="70" y="938" width="560" height="72" as="geometry" /></mxCell><mxCell id="a9" style="endArrow=classic;html=1;strokeColor=#6C8EBF;strokeWidth=2;rounded=0;edgeStyle=orthogonalEdgeStyle;" edge="1" parent="1" source="s8" target="s9"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="s10" value="&lt;b&gt;Взять лучшее и заслужить право оставить&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#444444&quot; style=&quot;font-size:11px&quot;&gt;позаимствованное проходит испытание или уходит&lt;/font&gt;&lt;br&gt;&lt;font color=&quot;#999999&quot; style=&quot;font-size:9px&quot;&gt;Take what is better, then earn the right to keep it&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F5F5F5;strokeColor=#666666;align=left;spacingLeft=10;fontSize=12;" vertex="1" parent="1"><mxGeometry x="70" y="1030" width="560" height="72" as="geometry" /></mxCell><mxCell id="a10" style="endArrow=classic;html=1;strokeColor=#6C8EBF;strokeWidth=2;rounded=0;edgeStyle=orthogonalEdgeStyle;" edge="1" parent="1" source="s9" target="s10"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="s11" value="&lt;b&gt;Скиллы, которых ты не писал&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#444444&quot; style=&quot;font-size:11px&quot;&gt;как читать чужое и не запускать его код&lt;/font&gt;&lt;br&gt;&lt;font color=&quot;#999999&quot; style=&quot;font-size:9px&quot;&gt;Skills you did not write&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F5F5F5;strokeColor=#666666;align=left;spacingLeft=10;fontSize=12;" vertex="1" parent="1"><mxGeometry x="70" y="1122" width="560" height="72" as="geometry" /></mxCell><mxCell id="a11" style="endArrow=classic;html=1;strokeColor=#6C8EBF;strokeWidth=2;rounded=0;edgeStyle=orthogonalEdgeStyle;" edge="1" parent="1" source="s10" target="s11"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="l0" value="ЧТО ЭТО ЗА СХЕМА" style="text;html=1;align=left;verticalAlign=middle;fontSize=12;fontStyle=1;strokeColor=none;fillColor=none;" vertex="1" parent="1"><mxGeometry x="700" y="110" width="640" height="26" as="geometry" /></mxCell><mxCell id="l1" value="Порядок работы скилла create-a-skill: шаги в том порядке, в каком их надо делать." style="text;html=1;align=left;verticalAlign=middle;fontSize=12;fontStyle=0;strokeColor=none;fillColor=none;" vertex="1" parent="1"><mxGeometry x="700" y="140" width="640" height="26" as="geometry" /></mxCell><mxCell id="l2" value="Это НЕ структура файлов (family.drawio) и НЕ ворота регламента (gates.drawio)." style="text;html=1;align=left;verticalAlign=middle;fontSize=12;fontStyle=0;strokeColor=none;fillColor=none;" vertex="1" parent="1"><mxGeometry x="700" y="170" width="640" height="26" as="geometry" /></mxCell><mxCell id="l3" value="" style="text;html=1;align=left;verticalAlign=middle;fontSize=12;fontStyle=0;strokeColor=none;fillColor=none;" vertex="1" parent="1"><mxGeometry x="700" y="200" width="640" height="26" as="geometry" /></mxCell><mxCell id="l4" value="КАК ЧИТАТЬ" style="text;html=1;align=left;verticalAlign=middle;fontSize=12;fontStyle=1;strokeColor=none;fillColor=none;" vertex="1" parent="1"><mxGeometry x="700" y="230" width="640" height="26" as="geometry" /></mxCell><mxCell id="l5" value="Синяя рамка сверху — сам скилл. Стрелка вниз — следующий шаг." style="text;html=1;align=left;verticalAlign=middle;fontSize=12;fontStyle=0;strokeColor=none;fillColor=none;" vertex="1" parent="1"><mxGeometry x="700" y="260" width="640" height="26" as="geometry" /></mxCell><mxCell id="l6" value="Заголовок по-русски, под ним зачем этот шаг, внизу мелко — исходный заголовок из файла." style="text;html=1;align=left;verticalAlign=middle;fontSize=12;fontStyle=0;strokeColor=none;fillColor=none;" vertex="1" parent="1"><mxGeometry x="700" y="290" width="640" height="26" as="geometry" /></mxCell><mxCell id="l7" value="" style="text;html=1;align=left;verticalAlign=middle;fontSize=12;fontStyle=0;strokeColor=none;fillColor=none;" vertex="1" parent="1"><mxGeometry x="700" y="320" width="640" height="26" as="geometry" /></mxCell><mxCell id="l8" value="О ЧЁМ ЭТОТ СКИЛЛ" style="text;html=1;align=left;verticalAlign=middle;fontSize=12;fontStyle=1;strokeColor=none;fillColor=none;" vertex="1" parent="1"><mxGeometry x="700" y="350" width="640" height="26" as="geometry" /></mxCell><mxCell id="l9" value="Скилл — это программа, интерпретатор которой модель. Пишется для агента, а не для читателя." style="text;html=1;align=left;verticalAlign=middle;fontSize=12;fontStyle=0;strokeColor=none;fillColor=none;" vertex="1" parent="1"><mxGeometry x="700" y="380" width="640" height="26" as="geometry" /></mxCell></root></mxGraphModel></diagram></mxfile>