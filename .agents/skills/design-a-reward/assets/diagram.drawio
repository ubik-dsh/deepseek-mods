<mxfile host="dsh" agent="draw-a-skill-flow.py"><diagram id="design-a-reward" name="Как устроить награду"><mxGraphModel dx="0" dy="0" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1582" pageHeight="1540" math="0" shadow="0"><root><mxCell id="0" /><mxCell id="1" parent="0" /><mxCell id="head" value="Как устроить награду" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;shadow=1;strokeWidth=2;fillColor=#DAE8FC;strokeColor=#6C8EBF;fontSize=18;fontStyle=1;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="90" y="60" width="640" height="78" as="geometry" /></mxCell><mxCell id="s0" value="&lt;b&gt;Записать утверждение фразой и попробовать его побить&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#444444&quot; style=&quot;font-size:11px&quot;&gt;награда — это гипотеза, пока её не опровергли&lt;/font&gt;&lt;br&gt;&lt;font color=&quot;#999999&quot; style=&quot;font-size:9px&quot;&gt;Step 1 — Write the claim down as a sentence, then try to beat it&lt;/font&gt;" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;shadow=1;strokeWidth=1;fillColor=#DAE8FC;strokeColor=#6C8EBF;align=left;verticalAlign=middle;spacingLeft=20;spacingTop=10;spacingBottom=10;fontSize=13;" vertex="1" parent="1"><mxGeometry x="90" y="180" width="640" height="88" as="geometry" /></mxCell><mxCell id="a0" style="endArrow=classic;html=1;strokeColor=#6C8EBF;strokeWidth=2;rounded=0;edgeStyle=orthogonalEdgeStyle;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="head" target="s0"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="s1" value="&lt;b&gt;Проверить, что награда УМЕЕТ проигрывать&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#444444&quot; style=&quot;font-size:11px&quot;&gt;награду, которую нельзя провалить, нельзя и выиграть&lt;/font&gt;&lt;br&gt;&lt;font color=&quot;#999999&quot; style=&quot;font-size:9px&quot;&gt;Step 2 — Check the reward can fail&lt;/font&gt;" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;shadow=1;strokeWidth=1;fillColor=#FFE6CC;strokeColor=#D79B00;align=left;verticalAlign=middle;spacingLeft=20;spacingTop=10;spacingBottom=10;fontSize=13;" vertex="1" parent="1"><mxGeometry x="90" y="310" width="640" height="88" as="geometry" /></mxCell><mxCell id="a1" style="endArrow=classic;html=1;strokeColor=#6C8EBF;strokeWidth=2;rounded=0;edgeStyle=orthogonalEdgeStyle;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="s0" target="s1"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="s2" value="&lt;b&gt;Убедиться, что каждая ветка срабатывает&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#444444&quot; style=&quot;font-size:11px&quot;&gt;мёртвая ветка выглядит как честная&lt;/font&gt;&lt;br&gt;&lt;font color=&quot;#999999&quot; style=&quot;font-size:9px&quot;&gt;Step 3 — Make sure every branch actually fires&lt;/font&gt;" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;shadow=1;strokeWidth=1;fillColor=#E1D5E7;strokeColor=#9673A6;align=left;verticalAlign=middle;spacingLeft=20;spacingTop=10;spacingBottom=10;fontSize=13;" vertex="1" parent="1"><mxGeometry x="90" y="440" width="640" height="88" as="geometry" /></mxCell><mxCell id="a2" style="endArrow=classic;html=1;strokeColor=#6C8EBF;strokeWidth=2;rounded=0;edgeStyle=orthogonalEdgeStyle;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="s1" target="s2"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="s3" value="&lt;b&gt;Оценивать по шкале, если да-нет действительно не всё&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#444444&quot; style=&quot;font-size:11px&quot;&gt;грубая оценка прячет прогресс&lt;/font&gt;&lt;br&gt;&lt;font color=&quot;#999999&quot; style=&quot;font-size:9px&quot;&gt;Step 4 — Grade it, unless a yes-or-no is genuinely all there is&lt;/font&gt;" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;shadow=1;strokeWidth=1;fillColor=#D5E8D4;strokeColor=#82B366;align=left;verticalAlign=middle;spacingLeft=20;spacingTop=10;spacingBottom=10;fontSize=13;" vertex="1" parent="1"><mxGeometry x="90" y="570" width="640" height="88" as="geometry" /></mxCell><mxCell id="a3" style="endArrow=classic;html=1;strokeColor=#6C8EBF;strokeWidth=2;rounded=0;edgeStyle=orthogonalEdgeStyle;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="s2" target="s3"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="s4" value="&lt;b&gt;Найти границы, измерив чего ученик достигает&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#444444&quot; style=&quot;font-size:11px&quot;&gt;границы берутся из замера, а не из вкуса&lt;/font&gt;&lt;br&gt;&lt;font color=&quot;#999999&quot; style=&quot;font-size:9px&quot;&gt;Step 5 — Find the limits by measuring what the learner achieves&lt;/font&gt;" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;shadow=1;strokeWidth=1;fillColor=#F5F5F5;strokeColor=#666666;align=left;verticalAlign=middle;spacingLeft=20;spacingTop=10;spacingBottom=10;fontSize=13;" vertex="1" parent="1"><mxGeometry x="90" y="700" width="640" height="88" as="geometry" /></mxCell><mxCell id="a4" style="endArrow=classic;html=1;strokeColor=#6C8EBF;strokeWidth=2;rounded=0;edgeStyle=orthogonalEdgeStyle;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="s3" target="s4"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="s5" value="&lt;b&gt;Шаг выбирать по форме награды, а не по вкусу&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#444444&quot; style=&quot;font-size:11px&quot;&gt;форма диктует шаг&lt;/font&gt;&lt;br&gt;&lt;font color=&quot;#999999&quot; style=&quot;font-size:9px&quot;&gt;Step 6 — Choose the step from the reward&#x27;s shape, not from taste&lt;/font&gt;" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;shadow=1;strokeWidth=1;fillColor=#F5F5F5;strokeColor=#666666;align=left;verticalAlign=middle;spacingLeft=20;spacingTop=10;spacingBottom=10;fontSize=13;" vertex="1" parent="1"><mxGeometry x="90" y="830" width="640" height="88" as="geometry" /></mxCell><mxCell id="a5" style="endArrow=classic;html=1;strokeColor=#6C8EBF;strokeWidth=2;rounded=0;edgeStyle=orthogonalEdgeStyle;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="s4" target="s5"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="s6" value="&lt;b&gt;Не дать безопасному действию задавить остальные&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#444444&quot; style=&quot;font-size:11px&quot;&gt;осторожность не должна быть выгоднее работы&lt;/font&gt;&lt;br&gt;&lt;font color=&quot;#999999&quot; style=&quot;font-size:9px&quot;&gt;Step 7 — Do not let a safe action dominate&lt;/font&gt;" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;shadow=1;strokeWidth=1;fillColor=#F5F5F5;strokeColor=#666666;align=left;verticalAlign=middle;spacingLeft=20;spacingTop=10;spacingBottom=10;fontSize=13;" vertex="1" parent="1"><mxGeometry x="90" y="960" width="640" height="88" as="geometry" /></mxCell><mxCell id="a6" style="endArrow=classic;html=1;strokeColor=#6C8EBF;strokeWidth=2;rounded=0;edgeStyle=orthogonalEdgeStyle;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="s5" target="s6"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="s7" value="&lt;b&gt;Если двое соревнуются, монотонной кривой не ждать&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#444444&quot; style=&quot;font-size:11px&quot;&gt;сумма постоянна — рост одного не рост общего&lt;/font&gt;&lt;br&gt;&lt;font color=&quot;#999999&quot; style=&quot;font-size:9px&quot;&gt;Step 8 — If two learners compete, stop expecting a monotone curve&lt;/font&gt;" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;shadow=1;strokeWidth=1;fillColor=#F5F5F5;strokeColor=#666666;align=left;verticalAlign=middle;spacingLeft=20;spacingTop=10;spacingBottom=10;fontSize=13;" vertex="1" parent="1"><mxGeometry x="90" y="1090" width="640" height="88" as="geometry" /></mxCell><mxCell id="a7" style="endArrow=classic;html=1;strokeColor=#6C8EBF;strokeWidth=2;rounded=0;edgeStyle=orthogonalEdgeStyle;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="s6" target="s7"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="s8" value="&lt;b&gt;Когда кривая не растёт — проверять в этом порядке&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#444444&quot; style=&quot;font-size:11px&quot;&gt;порядок проверок, от дешёвой к дорогой&lt;/font&gt;&lt;br&gt;&lt;font color=&quot;#999999&quot; style=&quot;font-size:9px&quot;&gt;Step 9 — When the curve will not rise, check in this order&lt;/font&gt;" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;shadow=1;strokeWidth=1;fillColor=#F5F5F5;strokeColor=#666666;align=left;verticalAlign=middle;spacingLeft=20;spacingTop=10;spacingBottom=10;fontSize=13;" vertex="1" parent="1"><mxGeometry x="90" y="1220" width="640" height="88" as="geometry" /></mxCell><mxCell id="a8" style="endArrow=classic;html=1;strokeColor=#6C8EBF;strokeWidth=2;rounded=0;edgeStyle=orthogonalEdgeStyle;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="s7" target="s8"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="s9" value="&lt;b&gt;Записать награду как договор&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#444444&quot; style=&quot;font-size:11px&quot;&gt;что считается успехом, а что нет&lt;/font&gt;&lt;br&gt;&lt;font color=&quot;#999999&quot; style=&quot;font-size:9px&quot;&gt;Step 10 — Write the reward down as a contract&lt;/font&gt;" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;shadow=1;strokeWidth=1;fillColor=#F5F5F5;strokeColor=#666666;align=left;verticalAlign=middle;spacingLeft=20;spacingTop=10;spacingBottom=10;fontSize=13;" vertex="1" parent="1"><mxGeometry x="90" y="1350" width="640" height="88" as="geometry" /></mxCell><mxCell id="a9" style="endArrow=classic;html=1;strokeColor=#6C8EBF;strokeWidth=2;rounded=0;edgeStyle=orthogonalEdgeStyle;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="s8" target="s9"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="legend" value="&lt;b&gt;ЧТО ЭТО ЗА СХЕМА&lt;/b&gt;&lt;br&gt;Порядок работы скилла design-a-reward: шаги в том порядке, в каком их надо делать.&lt;br&gt;Это НЕ структура файлов (family.drawio) и НЕ ворота регламента (gates.drawio).&lt;br&gt;&amp;nbsp;&lt;br&gt;&lt;b&gt;КАК ЧИТАТЬ&lt;/b&gt;&lt;br&gt;Синяя рамка сверху — сам скилл. Стрелка вниз — следующий шаг.&lt;br&gt;Заголовок по-русски, под ним зачем этот шаг, внизу мелко — исходный заголовок.&lt;br&gt;&amp;nbsp;&lt;br&gt;&lt;b&gt;О ЧЁМ ЭТОТ СКИЛЛ&lt;/b&gt;&lt;br&gt;Что мерить, как оценивать и как понять, что кривая не растёт.&lt;br&gt;&amp;nbsp;" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;shadow=1;strokeWidth=1;fillColor=#FFFFFF;strokeColor=#B3B3B3;align=left;verticalAlign=top;spacingLeft=20;spacingTop=10;fontSize=11;" vertex="1" parent="1"><mxGeometry x="832" y="60" width="660" height="226" as="geometry" /></mxCell></root></mxGraphModel></diagram></mxfile>