<mxfile host="dsh" agent="draw-the-hearing.py"><diagram id="hearing" name="Суд"><mxGraphModel dx="0" dy="0" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1942" pageHeight="1814" math="0" shadow="0"><root><mxCell id="0" /><mxCell id="1" parent="0" /><mxCell id="head" value="СУД НАД СКИЛЛОМ — judge-a-skill" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;shadow=1;strokeWidth=2;fillColor=#DAE8FC;strokeColor=#6C8EBF;fontSize=18;fontStyle=1;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="90" y="60" width="900" height="78" as="geometry" /></mxCell><mxCell id="defendant" value="СКИЛЛ-ПОДСУДИМЫЙ" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;shadow=1;strokeWidth=1;fillColor=#DAE8FC;strokeColor=#6C8EBF;align=left;verticalAlign=middle;spacingLeft=20;spacingTop=10;spacingBottom=10;fontSize=13;" vertex="1" parent="1"><mxGeometry x="90" y="226" width="900" height="56" as="geometry" /></mxCell><mxCell id="band_steps" value="ВОСЕМЬ ШАГОВ СУДА — в порядке исполнения" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#F5F5F5;strokeColor=#666666;align=left;verticalAlign=middle;spacingLeft=20;fontStyle=1;fontSize=12;" vertex="1" parent="1"><mxGeometry x="90" y="324" width="900" height="34" as="geometry" /></mxCell><mxCell id="band_verdicts" value="ПЯТЬ ПРИГОВОРОВ — из них выбирает судья" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#F5F5F5;strokeColor=#666666;align=left;verticalAlign=middle;spacingLeft=20;fontStyle=1;fontSize=12;" vertex="1" parent="1"><mxGeometry x="1092" y="324" width="760" height="34" as="geometry" /></mxCell><mxCell id="s0" value="&lt;b&gt;Step 0 — Стоит ли вообще судить&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#444444&quot; style=&quot;font-size:11px&quot;&gt;Не созывать суд по каждому поводу&lt;/font&gt;&lt;br&gt;&lt;font color=&quot;#999999&quot; style=&quot;font-size:9px&quot;&gt;Is a hearing worth it?&lt;/font&gt;" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;shadow=1;strokeWidth=1;fillColor=#F5F5F5;strokeColor=#666666;align=left;verticalAlign=middle;spacingLeft=20;spacingTop=10;spacingBottom=10;fontSize=13;" vertex="1" parent="1"><mxGeometry x="90" y="400" width="900" height="88" as="geometry" /></mxCell><mxCell id="a0" style="endArrow=classic;html=1;strokeColor=#6C8EBF;strokeWidth=2;dashed=0;rounded=0;edgeStyle=orthogonalEdgeStyle;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="defendant" target="s0"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="s1" value="&lt;b&gt;Step 1 — Структурная проверка — до всякого спора&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#444444&quot; style=&quot;font-size:11px&quot;&gt;Спор о содержании сломанного файла — потеря времени&lt;/font&gt;&lt;br&gt;&lt;font color=&quot;#999999&quot; style=&quot;font-size:9px&quot;&gt;The structural check, before any argument&lt;/font&gt;" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;shadow=1;strokeWidth=1;fillColor=#FFE6CC;strokeColor=#D79B00;align=left;verticalAlign=middle;spacingLeft=20;spacingTop=10;spacingBottom=10;fontSize=13;" vertex="1" parent="1"><mxGeometry x="90" y="530" width="900" height="88" as="geometry" /></mxCell><mxCell id="a1" style="endArrow=classic;html=1;strokeColor=#6C8EBF;strokeWidth=2;dashed=0;rounded=0;edgeStyle=orthogonalEdgeStyle;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="s0" target="s1"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="s2" value="&lt;b&gt;Step 2 — Обвинительный лист — ДО чтения защиты&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#444444&quot; style=&quot;font-size:11px&quot;&gt;Сначала записать, что приговор обязан решить&lt;/font&gt;&lt;br&gt;&lt;font color=&quot;#999999&quot; style=&quot;font-size:9px&quot;&gt;Write the charge sheet before hearing anything&lt;/font&gt;" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;shadow=1;strokeWidth=1;fillColor=#FFE6CC;strokeColor=#D79B00;align=left;verticalAlign=middle;spacingLeft=20;spacingTop=10;spacingBottom=10;fontSize=13;" vertex="1" parent="1"><mxGeometry x="90" y="660" width="900" height="88" as="geometry" /></mxCell><mxCell id="a2" style="endArrow=classic;html=1;strokeColor=#6C8EBF;strokeWidth=2;dashed=0;rounded=0;edgeStyle=orthogonalEdgeStyle;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="s1" target="s2"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="s3" value="&lt;b&gt;Step 3 — Обвинение&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#444444&quot; style=&quot;font-size:11px&quot;&gt;Доказывает, почему скилл НЕ надо оставлять&lt;/font&gt;&lt;br&gt;&lt;font color=&quot;#999999&quot; style=&quot;font-size:9px&quot;&gt;The prosecution&lt;/font&gt;" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;shadow=1;strokeWidth=1;fillColor=#F8CECC;strokeColor=#B85450;align=left;verticalAlign=middle;spacingLeft=20;spacingTop=10;spacingBottom=10;fontSize=13;" vertex="1" parent="1"><mxGeometry x="90" y="790" width="900" height="88" as="geometry" /></mxCell><mxCell id="a3" style="endArrow=classic;html=1;strokeColor=#6C8EBF;strokeWidth=2;dashed=0;rounded=0;edgeStyle=orthogonalEdgeStyle;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="s2" target="s3"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="s4" value="&lt;b&gt;Step 4 — Защита&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#444444&quot; style=&quot;font-size:11px&quot;&gt;Доказывает, почему скилл надо оставить&lt;/font&gt;&lt;br&gt;&lt;font color=&quot;#999999&quot; style=&quot;font-size:9px&quot;&gt;The defence&lt;/font&gt;" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;shadow=1;strokeWidth=1;fillColor=#D5E8D4;strokeColor=#82B366;align=left;verticalAlign=middle;spacingLeft=20;spacingTop=10;spacingBottom=10;fontSize=13;" vertex="1" parent="1"><mxGeometry x="90" y="920" width="900" height="88" as="geometry" /></mxCell><mxCell id="a4" style="endArrow=classic;html=1;strokeColor=#6C8EBF;strokeWidth=2;dashed=0;rounded=0;edgeStyle=orthogonalEdgeStyle;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="s3" target="s4"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="s5" value="&lt;b&gt;Step 5 — Судья&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#444444&quot; style=&quot;font-size:11px&quot;&gt;Решает&lt;/font&gt;&lt;br&gt;&lt;font color=&quot;#999999&quot; style=&quot;font-size:9px&quot;&gt;The judge&lt;/font&gt;" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;shadow=1;strokeWidth=1;fillColor=#DAE8FC;strokeColor=#6C8EBF;align=left;verticalAlign=middle;spacingLeft=20;spacingTop=10;spacingBottom=10;fontSize=13;" vertex="1" parent="1"><mxGeometry x="90" y="1050" width="900" height="88" as="geometry" /></mxCell><mxCell id="a5" style="endArrow=classic;html=1;strokeColor=#6C8EBF;strokeWidth=2;dashed=0;rounded=0;edgeStyle=orthogonalEdgeStyle;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="s4" target="s5"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="s6" value="&lt;b&gt;Step 6 — Оценка двух сторон&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#444444&quot; style=&quot;font-size:11px&quot;&gt;Два числа из десяти, и кто победил&lt;/font&gt;&lt;br&gt;&lt;font color=&quot;#999999&quot; style=&quot;font-size:9px&quot;&gt;Rate the two cases&lt;/font&gt;" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;shadow=1;strokeWidth=1;fillColor=#E1D5E7;strokeColor=#9673A6;align=left;verticalAlign=middle;spacingLeft=20;spacingTop=10;spacingBottom=10;fontSize=13;" vertex="1" parent="1"><mxGeometry x="90" y="1180" width="900" height="88" as="geometry" /></mxCell><mxCell id="a6" style="endArrow=classic;html=1;strokeColor=#6C8EBF;strokeWidth=2;dashed=0;rounded=0;edgeStyle=orthogonalEdgeStyle;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="s5" target="s6"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="s7" value="&lt;b&gt;Step 7 — Запись&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#444444&quot; style=&quot;font-size:11px&quot;&gt;Где найдёт следующий: лист, обе стороны, оценка, приговор&lt;/font&gt;&lt;br&gt;&lt;font color=&quot;#999999&quot; style=&quot;font-size:9px&quot;&gt;Record it&lt;/font&gt;" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;shadow=1;strokeWidth=1;fillColor=#E1D5E7;strokeColor=#9673A6;align=left;verticalAlign=middle;spacingLeft=20;spacingTop=10;spacingBottom=10;fontSize=13;" vertex="1" parent="1"><mxGeometry x="90" y="1310" width="900" height="88" as="geometry" /></mxCell><mxCell id="a7" style="endArrow=classic;html=1;strokeColor=#6C8EBF;strokeWidth=2;dashed=0;rounded=0;edgeStyle=orthogonalEdgeStyle;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="s6" target="s7"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="v0" value="&lt;b&gt;ОПРАВДАН&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#444444&quot; style=&quot;font-size:11px&quot;&gt;ни один конкретный довод не устоял — оставить целиком&lt;/font&gt;&lt;br&gt;&lt;font color=&quot;#999999&quot; style=&quot;font-size:9px&quot;&gt;Acquit&lt;/font&gt;" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;shadow=1;strokeWidth=1;fillColor=#D5E8D4;strokeColor=#82B366;align=left;verticalAlign=middle;spacingLeft=20;spacingTop=10;spacingBottom=10;fontSize=13;" vertex="1" parent="1"><mxGeometry x="1092" y="400" width="760" height="88" as="geometry" /></mxCell><mxCell id="v1" value="&lt;b&gt;ОСТАВИТЬ С ГРАНИЦЕЙ&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#444444&quot; style=&quot;font-size:11px&quot;&gt;работает, но только при названных условиях — их и записать&lt;/font&gt;&lt;br&gt;&lt;font color=&quot;#999999&quot; style=&quot;font-size:9px&quot;&gt;Keep with a boundary&lt;/font&gt;" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;shadow=1;strokeWidth=1;fillColor=#D5E8D4;strokeColor=#82B366;align=left;verticalAlign=middle;spacingLeft=20;spacingTop=10;spacingBottom=10;fontSize=13;" vertex="1" parent="1"><mxGeometry x="1092" y="530" width="760" height="88" as="geometry" /></mxCell><mxCell id="v2" value="&lt;b&gt;ПОЧИНИТЬ&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#444444&quot; style=&quot;font-size:11px&quot;&gt;замысел верен, файл его предаёт — сказать, что менять&lt;/font&gt;&lt;br&gt;&lt;font color=&quot;#999999&quot; style=&quot;font-size:9px&quot;&gt;Fix&lt;/font&gt;" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;shadow=1;strokeWidth=1;fillColor=#FFF2CC;strokeColor=#D6B656;align=left;verticalAlign=middle;spacingLeft=20;spacingTop=10;spacingBottom=10;fontSize=13;" vertex="1" parent="1"><mxGeometry x="1092" y="660" width="760" height="88" as="geometry" /></mxCell><mxCell id="v3" value="&lt;b&gt;ОТВЕРГНУТЬ СКИЛЛ, ВЗЯТЬ ЧАСТИ&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#444444&quot; style=&quot;font-size:11px&quot;&gt;скилл не стоит держать, а части его — стоят&lt;/font&gt;&lt;br&gt;&lt;font color=&quot;#999999&quot; style=&quot;font-size:9px&quot;&gt;Reject the skill, take these parts&lt;/font&gt;" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;shadow=1;strokeWidth=1;fillColor=#FFE6CC;strokeColor=#D79B00;align=left;verticalAlign=middle;spacingLeft=20;spacingTop=10;spacingBottom=10;fontSize=13;" vertex="1" parent="1"><mxGeometry x="1092" y="790" width="760" height="88" as="geometry" /></mxCell><mxCell id="v4" value="&lt;b&gt;ОТВЕРГНУТЬ ЦЕЛИКОМ&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#444444&quot; style=&quot;font-size:11px&quot;&gt;не уцелело ничего&lt;/font&gt;&lt;br&gt;&lt;font color=&quot;#999999&quot; style=&quot;font-size:9px&quot;&gt;Reject entirely&lt;/font&gt;" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;shadow=1;strokeWidth=1;fillColor=#F8CECC;strokeColor=#B85450;align=left;verticalAlign=middle;spacingLeft=20;spacingTop=10;spacingBottom=10;fontSize=13;" vertex="1" parent="1"><mxGeometry x="1092" y="920" width="760" height="88" as="geometry" /></mxCell><mxCell id="av" style="endArrow=classic;html=1;strokeColor=#6C8EBF;strokeWidth=2;dashed=1;edgeStyle=orthogonalEdgeStyle;" edge="1" parent="1" source="s5" target="v0"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="legend" value="&lt;b&gt;ЧТО ЭТО ЗА СХЕМА&lt;/b&gt;&lt;br&gt;Процесс суда над скиллом — judge-a-skill. Как скилл обвиняют, защищают и судят.&lt;br&gt;Это НЕ схема файлов (family.drawio) и НЕ ворота регламента (gates.drawio).&lt;br&gt;У каждого процесса своя схема, и они друг друга не заменяют.&lt;br&gt;&amp;nbsp;&lt;br&gt;&lt;b&gt;КАК ЧИТАТЬ&lt;/b&gt;&lt;br&gt;Синяя рамка сверху — подсудимый. Стрелка вниз — следующий шаг суда.&lt;br&gt;Красная — сторона обвинения. Зелёная — сторона защиты.&lt;br&gt;Пунктир к колонке справа — «судья выбирает одно из пяти».&lt;br&gt;&amp;nbsp;&lt;br&gt;&lt;b&gt;ЧТО ГЛАВНОЕ В ЭТОМ ПРОЦЕССЕ&lt;/b&gt;&lt;br&gt;Обвинительный лист пишется ДО чтения защиты себя — иначе доводы подгоняются под ответ.&lt;br&gt;Чистый приговор — полноценный исход: если конкретного довода не уцелело, скилл оставляют.&lt;br&gt;Обе стороны получают оценку, чтобы близкое решение было видно как близкое.&lt;br&gt;&amp;nbsp;" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;shadow=1;strokeWidth=1;fillColor=#FFFFFF;strokeColor=#B3B3B3;align=left;verticalAlign=top;spacingLeft=20;spacingTop=10;fontSize=11;" vertex="1" parent="1"><mxGeometry x="90" y="1440" width="900" height="314" as="geometry" /></mxCell></root></mxGraphModel></diagram></mxfile>