<mxfile host="dsh" agent="draw-the-hearing.py"><diagram id="hearing" name="Суд"><mxGraphModel dx="0" dy="0" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1300" pageHeight="1400" math="0" shadow="0"><root><mxCell id="0" /><mxCell id="1" parent="0" /><mxCell id="defendant" value="СКИЛЛ-ПОДСУДИМЫЙ" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#DAE8FC;strokeColor=#6C8EBF;fontSize=16;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="80" y="40" width="420" height="50" as="geometry" /></mxCell><mxCell id="s0" value="&lt;b&gt;Step 0 — Стоит ли вообще судить&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#333333&quot; style=&quot;font-size:11px&quot;&gt;Не созывать суд по каждому поводу&lt;/font&gt;&lt;br&gt;&lt;font color=&quot;#888888&quot; style=&quot;font-size:9px&quot;&gt;Is a hearing worth it?&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F5F5F5;strokeColor=#666666;align=left;spacingLeft=10;fontSize=12;" vertex="1" parent="1"><mxGeometry x="80" y="140" width="540" height="76" as="geometry" /></mxCell><mxCell id="a0" style="endArrow=classic;html=1;strokeColor=#6C8EBF;strokeWidth=2;rounded=0;edgeStyle=orthogonalEdgeStyle;" edge="1" parent="1" source="defendant" target="s0"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="s1" value="&lt;b&gt;Step 1 — Структурная проверка — до всякого спора&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#333333&quot; style=&quot;font-size:11px&quot;&gt;Спор о содержании сломанного файла — потеря времени&lt;/font&gt;&lt;br&gt;&lt;font color=&quot;#888888&quot; style=&quot;font-size:9px&quot;&gt;The structural check, before any argument&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFE6CC;strokeColor=#D79B00;align=left;spacingLeft=10;fontSize=12;" vertex="1" parent="1"><mxGeometry x="80" y="236" width="540" height="76" as="geometry" /></mxCell><mxCell id="a1" style="endArrow=classic;html=1;strokeColor=#6C8EBF;strokeWidth=2;rounded=0;edgeStyle=orthogonalEdgeStyle;" edge="1" parent="1" source="s0" target="s1"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="s2" value="&lt;b&gt;Step 2 — Обвинительный лист — ДО чтения защиты&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#333333&quot; style=&quot;font-size:11px&quot;&gt;Сначала записать, что приговор обязан решить&lt;/font&gt;&lt;br&gt;&lt;font color=&quot;#888888&quot; style=&quot;font-size:9px&quot;&gt;Write the charge sheet before hearing anything&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFE6CC;strokeColor=#D79B00;align=left;spacingLeft=10;fontSize=12;" vertex="1" parent="1"><mxGeometry x="80" y="332" width="540" height="76" as="geometry" /></mxCell><mxCell id="a2" style="endArrow=classic;html=1;strokeColor=#6C8EBF;strokeWidth=2;rounded=0;edgeStyle=orthogonalEdgeStyle;" edge="1" parent="1" source="s1" target="s2"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="s3" value="&lt;b&gt;Step 3 — Обвинение&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#333333&quot; style=&quot;font-size:11px&quot;&gt;Доказывает, почему скилл НЕ надо оставлять&lt;/font&gt;&lt;br&gt;&lt;font color=&quot;#888888&quot; style=&quot;font-size:9px&quot;&gt;The prosecution&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F8CECC;strokeColor=#B85450;align=left;spacingLeft=10;fontSize=12;" vertex="1" parent="1"><mxGeometry x="80" y="428" width="540" height="76" as="geometry" /></mxCell><mxCell id="a3" style="endArrow=classic;html=1;strokeColor=#6C8EBF;strokeWidth=2;rounded=0;edgeStyle=orthogonalEdgeStyle;" edge="1" parent="1" source="s2" target="s3"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="s4" value="&lt;b&gt;Step 4 — Защита&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#333333&quot; style=&quot;font-size:11px&quot;&gt;Доказывает, почему скилл надо оставить&lt;/font&gt;&lt;br&gt;&lt;font color=&quot;#888888&quot; style=&quot;font-size:9px&quot;&gt;The defence&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#D5E8D4;strokeColor=#82B366;align=left;spacingLeft=10;fontSize=12;" vertex="1" parent="1"><mxGeometry x="80" y="524" width="540" height="76" as="geometry" /></mxCell><mxCell id="a4" style="endArrow=classic;html=1;strokeColor=#6C8EBF;strokeWidth=2;rounded=0;edgeStyle=orthogonalEdgeStyle;" edge="1" parent="1" source="s3" target="s4"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="s5" value="&lt;b&gt;Step 5 — Судья&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#333333&quot; style=&quot;font-size:11px&quot;&gt;Решает&lt;/font&gt;&lt;br&gt;&lt;font color=&quot;#888888&quot; style=&quot;font-size:9px&quot;&gt;The judge&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#DAE8FC;strokeColor=#6C8EBF;align=left;spacingLeft=10;fontSize=12;" vertex="1" parent="1"><mxGeometry x="80" y="620" width="540" height="76" as="geometry" /></mxCell><mxCell id="a5" style="endArrow=classic;html=1;strokeColor=#6C8EBF;strokeWidth=2;rounded=0;edgeStyle=orthogonalEdgeStyle;" edge="1" parent="1" source="s4" target="s5"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="s6" value="&lt;b&gt;Step 6 — Оценка двух сторон&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#333333&quot; style=&quot;font-size:11px&quot;&gt;Два числа из десяти, и кто победил&lt;/font&gt;&lt;br&gt;&lt;font color=&quot;#888888&quot; style=&quot;font-size:9px&quot;&gt;Rate the two cases&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E1D5E7;strokeColor=#9673A6;align=left;spacingLeft=10;fontSize=12;" vertex="1" parent="1"><mxGeometry x="80" y="716" width="540" height="76" as="geometry" /></mxCell><mxCell id="a6" style="endArrow=classic;html=1;strokeColor=#6C8EBF;strokeWidth=2;rounded=0;edgeStyle=orthogonalEdgeStyle;" edge="1" parent="1" source="s5" target="s6"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="s7" value="&lt;b&gt;Step 7 — Запись&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#333333&quot; style=&quot;font-size:11px&quot;&gt;Где найдёт следующий: лист, обе стороны, оценка, приговор&lt;/font&gt;&lt;br&gt;&lt;font color=&quot;#888888&quot; style=&quot;font-size:9px&quot;&gt;Record it&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E1D5E7;strokeColor=#9673A6;align=left;spacingLeft=10;fontSize=12;" vertex="1" parent="1"><mxGeometry x="80" y="812" width="540" height="76" as="geometry" /></mxCell><mxCell id="a7" style="endArrow=classic;html=1;strokeColor=#6C8EBF;strokeWidth=2;rounded=0;edgeStyle=orthogonalEdgeStyle;" edge="1" parent="1" source="s6" target="s7"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="vh" value="ПЯТЬ ПРИГОВОРОВ — из них выбирает судья" style="text;html=1;align=left;fontSize=14;fontStyle=1;strokeColor=none;fillColor=none;" vertex="1" parent="1"><mxGeometry x="700" y="112" width="520" height="26" as="geometry" /></mxCell><mxCell id="v148" value="&lt;b&gt;ОПРАВДАН&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px&quot;&gt;ни один конкретный довод не устоял — оставить целиком&lt;/font&gt;&lt;br&gt;&lt;font color=&quot;#888888&quot; style=&quot;font-size:9px&quot;&gt;Acquit&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#D5E8D4;strokeColor=#82B366;align=left;spacingLeft=10;fontSize=12;" vertex="1" parent="1"><mxGeometry x="700" y="148" width="520" height="70" as="geometry" /></mxCell><mxCell id="v232" value="&lt;b&gt;ОСТАВИТЬ С ГРАНИЦЕЙ&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px&quot;&gt;работает, но только при названных условиях — их и записать&lt;/font&gt;&lt;br&gt;&lt;font color=&quot;#888888&quot; style=&quot;font-size:9px&quot;&gt;Keep with a boundary&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#D5E8D4;strokeColor=#82B366;align=left;spacingLeft=10;fontSize=12;" vertex="1" parent="1"><mxGeometry x="700" y="232" width="520" height="70" as="geometry" /></mxCell><mxCell id="v316" value="&lt;b&gt;ПОЧИНИТЬ&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px&quot;&gt;замысел верен, файл его предаёт — сказать, что менять&lt;/font&gt;&lt;br&gt;&lt;font color=&quot;#888888&quot; style=&quot;font-size:9px&quot;&gt;Fix&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFF2CC;strokeColor=#D6B656;align=left;spacingLeft=10;fontSize=12;" vertex="1" parent="1"><mxGeometry x="700" y="316" width="520" height="70" as="geometry" /></mxCell><mxCell id="v400" value="&lt;b&gt;ОТВЕРГНУТЬ СКИЛЛ, ВЗЯТЬ ЧАСТИ&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px&quot;&gt;скилл не стоит держать, а части его — стоят&lt;/font&gt;&lt;br&gt;&lt;font color=&quot;#888888&quot; style=&quot;font-size:9px&quot;&gt;Reject the skill, take these parts&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFE6CC;strokeColor=#D79B00;align=left;spacingLeft=10;fontSize=12;" vertex="1" parent="1"><mxGeometry x="700" y="400" width="520" height="70" as="geometry" /></mxCell><mxCell id="v484" value="&lt;b&gt;ОТВЕРГНУТЬ ЦЕЛИКОМ&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px&quot;&gt;не уцелело ничего&lt;/font&gt;&lt;br&gt;&lt;font color=&quot;#888888&quot; style=&quot;font-size:9px&quot;&gt;Reject entirely&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F8CECC;strokeColor=#B85450;align=left;spacingLeft=10;fontSize=12;" vertex="1" parent="1"><mxGeometry x="700" y="484" width="520" height="70" as="geometry" /></mxCell><mxCell id="av" style="endArrow=classic;html=1;strokeColor=#6C8EBF;strokeWidth=2;dashed=1;edgeStyle=orthogonalEdgeStyle;" edge="1" parent="1" source="s5" target="v148"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="l0" value="ЧТО ЭТО ЗА СХЕМА" style="text;html=1;align=left;verticalAlign=middle;fontSize=12;fontStyle=1;strokeColor=none;fillColor=none;" vertex="1" parent="1"><mxGeometry x="80" y="1010" width="1140" height="24" as="geometry" /></mxCell><mxCell id="l1" value="Процесс суда над скиллом — judge-a-skill. Как скилл обвиняют, защищают и судят." style="text;html=1;align=left;verticalAlign=middle;fontSize=12;fontStyle=0;strokeColor=none;fillColor=none;" vertex="1" parent="1"><mxGeometry x="80" y="1036" width="1140" height="24" as="geometry" /></mxCell><mxCell id="l2" value="Это НЕ схема файлов (family.drawio) и НЕ ворота регламента (gates.drawio)." style="text;html=1;align=left;verticalAlign=middle;fontSize=12;fontStyle=0;strokeColor=none;fillColor=none;" vertex="1" parent="1"><mxGeometry x="80" y="1062" width="1140" height="24" as="geometry" /></mxCell><mxCell id="l3" value="У каждого процесса своя схема, и они друг друга не заменяют." style="text;html=1;align=left;verticalAlign=middle;fontSize=12;fontStyle=0;strokeColor=none;fillColor=none;" vertex="1" parent="1"><mxGeometry x="80" y="1088" width="1140" height="24" as="geometry" /></mxCell><mxCell id="l4" value="" style="text;html=1;align=left;verticalAlign=middle;fontSize=12;fontStyle=0;strokeColor=none;fillColor=none;" vertex="1" parent="1"><mxGeometry x="80" y="1114" width="1140" height="24" as="geometry" /></mxCell><mxCell id="l5" value="КАК ЧИТАТЬ" style="text;html=1;align=left;verticalAlign=middle;fontSize=12;fontStyle=1;strokeColor=none;fillColor=none;" vertex="1" parent="1"><mxGeometry x="80" y="1140" width="1140" height="24" as="geometry" /></mxCell><mxCell id="l6" value="Синяя рамка сверху — подсудимый. Стрелка вниз — следующий шаг суда." style="text;html=1;align=left;verticalAlign=middle;fontSize=12;fontStyle=0;strokeColor=none;fillColor=none;" vertex="1" parent="1"><mxGeometry x="80" y="1166" width="1140" height="24" as="geometry" /></mxCell><mxCell id="l7" value="Красная — сторона обвинения. Зелёная — сторона защиты." style="text;html=1;align=left;verticalAlign=middle;fontSize=12;fontStyle=0;strokeColor=none;fillColor=none;" vertex="1" parent="1"><mxGeometry x="80" y="1192" width="1140" height="24" as="geometry" /></mxCell><mxCell id="l8" value="Пунктир к колонке справа — «судья выбирает одно из пяти»." style="text;html=1;align=left;verticalAlign=middle;fontSize=12;fontStyle=0;strokeColor=none;fillColor=none;" vertex="1" parent="1"><mxGeometry x="80" y="1218" width="1140" height="24" as="geometry" /></mxCell><mxCell id="l9" value="" style="text;html=1;align=left;verticalAlign=middle;fontSize=12;fontStyle=0;strokeColor=none;fillColor=none;" vertex="1" parent="1"><mxGeometry x="80" y="1244" width="1140" height="24" as="geometry" /></mxCell><mxCell id="l10" value="ЧТО ГЛАВНОЕ В ЭТОМ ПРОЦЕССЕ" style="text;html=1;align=left;verticalAlign=middle;fontSize=12;fontStyle=1;strokeColor=none;fillColor=none;" vertex="1" parent="1"><mxGeometry x="80" y="1270" width="1140" height="24" as="geometry" /></mxCell><mxCell id="l11" value="Обвинительный лист пишется ДО чтения защиты себя — иначе доводы подгоняются под ответ." style="text;html=1;align=left;verticalAlign=middle;fontSize=12;fontStyle=0;strokeColor=none;fillColor=none;" vertex="1" parent="1"><mxGeometry x="80" y="1296" width="1140" height="24" as="geometry" /></mxCell><mxCell id="l12" value="Чистый приговор — полноценный исход: если конкретного довода не уцелело, скилл оставляют." style="text;html=1;align=left;verticalAlign=middle;fontSize=12;fontStyle=0;strokeColor=none;fillColor=none;" vertex="1" parent="1"><mxGeometry x="80" y="1322" width="1140" height="24" as="geometry" /></mxCell><mxCell id="l13" value="Обе стороны получают оценку, чтобы близкое решение было видно как близкое." style="text;html=1;align=left;verticalAlign=middle;fontSize=12;fontStyle=0;strokeColor=none;fillColor=none;" vertex="1" parent="1"><mxGeometry x="80" y="1348" width="1140" height="24" as="geometry" /></mxCell></root></mxGraphModel></diagram></mxfile>