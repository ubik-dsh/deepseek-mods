<mxfile host="dsh" agent="draw-the-vk-flow.py"><diagram id="vk" name="ВК"><mxGraphModel dx="0" dy="0" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1100" pageHeight="1600" math="0" shadow="0"><root><mxCell id="0" /><mxCell id="1" parent="0" /><mxCell id="in" value="ЗАДАЧА В ВК" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#DAE8FC;strokeColor=#6C8EBF;fontSize=16;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="80" y="30" width="380" height="46" as="geometry" /></mxCell><mxCell id="o0" value="&lt;b&gt;ГРАНИЦЫ&lt;/b&gt; — что этот ключ вообще может трогать" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#DAE8FC;strokeColor=#6C8EBF;align=left;spacingLeft=10;fontSize=11;" vertex="1" parent="1"><mxGeometry x="80" y="100" width="380" height="40" as="geometry" /></mxCell><mxCell id="o1" value="&lt;b&gt;ФУНКЦИИ&lt;/b&gt; — чем именно, каким методом" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#DAE8FC;strokeColor=#6C8EBF;align=left;spacingLeft=10;fontSize=11;" vertex="1" parent="1"><mxGeometry x="80" y="146" width="380" height="40" as="geometry" /></mxCell><mxCell id="ao1" style="endArrow=classic;html=1;strokeColor=#6C8EBF;strokeWidth=2;rounded=0;edgeStyle=orthogonalEdgeStyle;" edge="1" parent="1" source="o0" target="o1"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="o2" value="&lt;b&gt;СМЫСЛ&lt;/b&gt; — стоит ли это делать и что будет" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E1D5E7;strokeColor=#9673A6;align=left;spacingLeft=10;fontSize=11;" vertex="1" parent="1"><mxGeometry x="80" y="192" width="380" height="40" as="geometry" /></mxCell><mxCell id="ao2" style="endArrow=classic;html=1;strokeColor=#9673A6;strokeWidth=2;rounded=0;edgeStyle=orthogonalEdgeStyle;" edge="1" parent="1" source="o1" target="o2"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="o3" value="&lt;b&gt;ПРОСЬБЫ&lt;/b&gt; — что просил оператор и что из этого вышло" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E1D5E7;strokeColor=#9673A6;align=left;spacingLeft=10;fontSize=11;" vertex="1" parent="1"><mxGeometry x="80" y="238" width="380" height="40" as="geometry" /></mxCell><mxCell id="ao3" style="endArrow=classic;html=1;strokeColor=#9673A6;strokeWidth=2;rounded=0;edgeStyle=orthogonalEdgeStyle;" edge="1" parent="1" source="o2" target="o3"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="ao0" style="endArrow=classic;html=1;strokeColor=#6C8EBF;strokeWidth=2;rounded=0;edgeStyle=orthogonalEdgeStyle;" edge="1" parent="1" source="in" target="o0"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="as0" style="endArrow=classic;html=1;strokeColor=#6C8EBF;strokeWidth=2;rounded=0;edgeStyle=orthogonalEdgeStyle;" edge="1" parent="1" source="o3" target="s0"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="s0" value="&lt;b&gt;Step 0 — Предполётная проверка — ДО всего остального&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#444444&quot; style=&quot;font-size:11px&quot;&gt;резолвит сообщество и права, ничего не меняя&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFE6CC;strokeColor=#D79B00;align=left;spacingLeft=10;fontSize=12;" vertex="1" parent="1"><mxGeometry x="80" y="300" width="380" height="56" as="geometry" /></mxCell><mxCell id="s1" value="&lt;b&gt;Step 1 — Ключ живёт в окружении и больше нигде&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#444444&quot; style=&quot;font-size:11px&quot;&gt;никогда не печатать, не пересылать, не коммитить&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFE6CC;strokeColor=#D79B00;align=left;spacingLeft=10;fontSize=12;" vertex="1" parent="1"><mxGeometry x="80" y="374" width="380" height="56" as="geometry" /></mxCell><mxCell id="as1" style="endArrow=classic;html=1;strokeColor=#6C8EBF;strokeWidth=2;rounded=0;edgeStyle=orthogonalEdgeStyle;" edge="1" parent="1" source="s0" target="s1"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="s2" value="&lt;b&gt;Step 2 — Что ключ сообщества может и чего не может — измерено&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#444444&quot; style=&quot;font-size:11px&quot;&gt;смотри колонки справа&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFE6CC;strokeColor=#D79B00;align=left;spacingLeft=10;fontSize=12;" vertex="1" parent="1"><mxGeometry x="80" y="448" width="380" height="56" as="geometry" /></mxCell><mxCell id="as2" style="endArrow=classic;html=1;strokeColor=#6C8EBF;strokeWidth=2;rounded=0;edgeStyle=orthogonalEdgeStyle;" edge="1" parent="1" source="s1" target="s2"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="s3" value="&lt;b&gt;Step 3 — Ворота подтверждения&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#444444&quot; style=&quot;font-size:11px&quot;&gt;оператор видит текст до публикации&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F8CECC;strokeColor=#B85450;align=left;spacingLeft=10;fontSize=12;" vertex="1" parent="1"><mxGeometry x="80" y="522" width="380" height="56" as="geometry" /></mxCell><mxCell id="as3" style="endArrow=classic;html=1;strokeColor=#6C8EBF;strokeWidth=2;rounded=0;edgeStyle=orthogonalEdgeStyle;" edge="1" parent="1" source="s2" target="s3"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="s4" value="&lt;b&gt;Step 4 — Опубликовать или отложить&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#444444&quot; style=&quot;font-size:11px&quot;&gt;и подтвердить по post_id и глазами&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#D5E8D4;strokeColor=#82B366;align=left;spacingLeft=10;fontSize=12;" vertex="1" parent="1"><mxGeometry x="80" y="596" width="380" height="56" as="geometry" /></mxCell><mxCell id="as4" style="endArrow=classic;html=1;strokeColor=#6C8EBF;strokeWidth=2;rounded=0;edgeStyle=orthogonalEdgeStyle;" edge="1" parent="1" source="s3" target="s4"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="ch" value="&lt;b&gt;ЧТО ЭТОТ КЛЮЧ МОЖЕТ&lt;/b&gt; — измерено, не прочитано в документации" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#D5E8D4;strokeColor=#82B366;align=left;spacingLeft=10;fontSize=13;" vertex="1" parent="1"><mxGeometry x="540" y="100" width="470" height="30" as="geometry" /></mxCell><mxCell id="c0" value="+ wall.post — написать на стену" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#D5E8D4;strokeColor=#82B366;align=left;spacingLeft=10;fontSize=11;" vertex="1" parent="1"><mxGeometry x="540" y="142" width="470" height="38" as="geometry" /></mxCell><mxCell id="c1" value="+ groups.edit — правки сообщества (молча игнорирует лишнее)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#D5E8D4;strokeColor=#82B366;align=left;spacingLeft=10;fontSize=11;" vertex="1" parent="1"><mxGeometry x="540" y="188" width="470" height="38" as="geometry" /></mxCell><mxCell id="c2" value="+ wall.closeComments — закрыть комментарии" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#D5E8D4;strokeColor=#82B366;align=left;spacingLeft=10;fontSize=11;" vertex="1" parent="1"><mxGeometry x="540" y="234" width="470" height="38" as="geometry" /></mxCell><mxCell id="c3" value="+ groups.getById / getTokenPermissions — кто мы и что нам можно" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#D5E8D4;strokeColor=#82B366;align=left;spacingLeft=10;fontSize=11;" vertex="1" parent="1"><mxGeometry x="540" y="280" width="470" height="38" as="geometry" /></mxCell><mxCell id="c4" value="+ groups.getMembers / getBanned — участники и забаненные" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#D5E8D4;strokeColor=#82B366;align=left;spacingLeft=10;fontSize=11;" vertex="1" parent="1"><mxGeometry x="540" y="326" width="470" height="38" as="geometry" /></mxCell><mxCell id="c5" value="+ groups.getLongPollServer / setLongPollSettings — живая лента" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#D5E8D4;strokeColor=#82B366;align=left;spacingLeft=10;fontSize=11;" vertex="1" parent="1"><mxGeometry x="540" y="372" width="470" height="38" as="geometry" /></mxCell><mxCell id="c6" value="+ groups.addAddress / editAddress / deleteAddress — адреса" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#D5E8D4;strokeColor=#82B366;align=left;spacingLeft=10;fontSize=11;" vertex="1" parent="1"><mxGeometry x="540" y="418" width="470" height="38" as="geometry" /></mxCell><mxCell id="c7" value="+ вложение ДОКУМЕНТА к посту" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#D5E8D4;strokeColor=#82B366;align=left;spacingLeft=10;fontSize=11;" vertex="1" parent="1"><mxGeometry x="540" y="464" width="470" height="38" as="geometry" /></mxCell><mxCell id="nh" value="&lt;b&gt;ЧЕГО ЭТОТ КЛЮЧ НЕ МОЖЕТ&lt;/b&gt; — и это дороже, чем кажется" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F8CECC;strokeColor=#B85450;align=left;spacingLeft=10;fontSize=13;" vertex="1" parent="1"><mxGeometry x="540" y="530" width="470" height="30" as="geometry" /></mxCell><mxCell id="n0" value="− ЧИТАТЬ стену: wall.get / getById / getComments — ошибка 27" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F8CECC;strokeColor=#B85450;align=left;spacingLeft=10;fontSize=11;" vertex="1" parent="1"><mxGeometry x="540" y="572" width="470" height="44" as="geometry" /></mxCell><mxCell id="n1" value="− УДАЛИТЬ или ИСПРАВИТЬ пост: wall.delete / edit / restore — ошибка 27" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F8CECC;strokeColor=#B85450;align=left;spacingLeft=10;fontSize=11;" vertex="1" parent="1"><mxGeometry x="540" y="624" width="470" height="44" as="geometry" /></mxCell><mxCell id="n2" value="− photos.getWallUploadServer / saveWallPhoto — ошибка 27" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F8CECC;strokeColor=#B85450;align=left;spacingLeft=10;fontSize=11;" vertex="1" parent="1"><mxGeometry x="540" y="676" width="470" height="44" as="geometry" /></mxCell><mxCell id="n3" value="− приложить ФОТО к посту — вызов проходит, вложение пропадает" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F8CECC;strokeColor=#B85450;align=left;spacingLeft=10;fontSize=11;" vertex="1" parent="1"><mxGeometry x="540" y="728" width="470" height="44" as="geometry" /></mxCell><mxCell id="n4" value="− groups.create / editManager / removeUser / search — нужен ключ пользователя" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F8CECC;strokeColor=#B85450;align=left;spacingLeft=10;fontSize=11;" vertex="1" parent="1"><mxGeometry x="540" y="780" width="470" height="44" as="geometry" /></mxCell><mxCell id="n5" value="− groups.delete — такого метода НЕ СУЩЕСТВУЕТ ВООБЩЕ" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F8CECC;strokeColor=#B85450;align=left;spacingLeft=10;fontSize=11;" vertex="1" parent="1"><mxGeometry x="540" y="832" width="470" height="44" as="geometry" /></mxCell><mxCell id="th" value="&lt;b&gt;ЛОВУШКИ, КОТОРЫЕ СТОЯТ ДОРОЖЕ ВСЕГО&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFE6CC;strokeColor=#D79B00;align=left;spacingLeft=10;fontSize=13;" vertex="1" parent="1"><mxGeometry x="80" y="924" width="930" height="30" as="geometry" /></mxCell><mxCell id="t0" value="Ошибки приходят НЕ как ошибки HTTP. VK отвечает 200, а отказ лежит в теле." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFE6CC;strokeColor=#D79B00;align=left;spacingLeft=10;fontSize=11;" vertex="1" parent="1"><mxGeometry x="80" y="966" width="930" height="34" as="geometry" /></mxCell><mxCell id="t1" value="err 100 — метод есть и вызывается, но аргументы не те. err 27 — метод есть, токен чужой." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFE6CC;strokeColor=#D79B00;align=left;spacingLeft=10;fontSize=11;" vertex="1" parent="1"><mxGeometry x="80" y="1006" width="930" height="34" as="geometry" /></mxCell><mxCell id="t2" value="err 3 — такого метода нет. Это надо отправлять первым, как контроль." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFE6CC;strokeColor=#D79B00;align=left;spacingLeft=10;fontSize=11;" vertex="1" parent="1"><mxGeometry x="80" y="1046" width="930" height="34" as="geometry" /></mxCell><mxCell id="t3" value="groups.edit возвращает 1 на ЛЮБОЙ неизвестный параметр — «принято» не значит «применено»." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFE6CC;strokeColor=#D79B00;align=left;spacingLeft=10;fontSize=11;" vertex="1" parent="1"><mxGeometry x="80" y="1086" width="930" height="34" as="geometry" /></mxCell><mxCell id="t4" value="Нет безопасной пробы записи ключом сообщества: любая запись что-то меняет." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFE6CC;strokeColor=#D79B00;align=left;spacingLeft=10;fontSize=11;" vertex="1" parent="1"><mxGeometry x="80" y="1126" width="930" height="34" as="geometry" /></mxCell><mxCell id="l0" value="ЧТО ЭТО ЗА СХЕМА" style="text;html=1;align=left;verticalAlign=middle;fontSize=12;fontStyle=1;strokeColor=none;fillColor=none;" vertex="1" parent="1"><mxGeometry x="80" y="1204" width="1140" height="24" as="geometry" /></mxCell><mxCell id="l1" value="Работа с ВК: что ключ сообщества может и чего не может, и в каком порядке идёт публикация." style="text;html=1;align=left;verticalAlign=middle;fontSize=12;fontStyle=0;strokeColor=none;fillColor=none;" vertex="1" parent="1"><mxGeometry x="80" y="1230" width="1140" height="24" as="geometry" /></mxCell><mxCell id="l2" value="Это НЕ структура файлов (family.drawio), НЕ ворота (gates.drawio) и НЕ суд (hearing.drawio)." style="text;html=1;align=left;verticalAlign=middle;fontSize=12;fontStyle=0;strokeColor=none;fillColor=none;" vertex="1" parent="1"><mxGeometry x="80" y="1256" width="1140" height="24" as="geometry" /></mxCell><mxCell id="l3" value="" style="text;html=1;align=left;verticalAlign=middle;fontSize=12;fontStyle=0;strokeColor=none;fillColor=none;" vertex="1" parent="1"><mxGeometry x="80" y="1282" width="1140" height="24" as="geometry" /></mxCell><mxCell id="l4" value="КАК ЧИТАТЬ" style="text;html=1;align=left;verticalAlign=middle;fontSize=12;fontStyle=1;strokeColor=none;fillColor=none;" vertex="1" parent="1"><mxGeometry x="80" y="1308" width="1140" height="24" as="geometry" /></mxCell><mxCell id="l5" value="Слева сверху вниз — порядок мышления и шаги публикации." style="text;html=1;align=left;verticalAlign=middle;fontSize=12;fontStyle=0;strokeColor=none;fillColor=none;" vertex="1" parent="1"><mxGeometry x="80" y="1334" width="1140" height="24" as="geometry" /></mxCell><mxCell id="l6" value="Зелёная колонка — что получается. Красная — что не получается, и это важнее." style="text;html=1;align=left;verticalAlign=middle;fontSize=12;fontStyle=0;strokeColor=none;fillColor=none;" vertex="1" parent="1"><mxGeometry x="80" y="1360" width="1140" height="24" as="geometry" /></mxCell><mxCell id="l7" value="" style="text;html=1;align=left;verticalAlign=middle;fontSize=12;fontStyle=0;strokeColor=none;fillColor=none;" vertex="1" parent="1"><mxGeometry x="80" y="1386" width="1140" height="24" as="geometry" /></mxCell><mxCell id="l8" value="ПОЧЕМУ КРАСНАЯ КОЛОНКА ГЛАВНАЯ" style="text;html=1;align=left;verticalAlign=middle;fontSize=12;fontStyle=1;strokeColor=none;fillColor=none;" vertex="1" parent="1"><mxGeometry x="80" y="1412" width="1140" height="24" as="geometry" /></mxCell><mxCell id="l9" value="Отказы здесь приходят как успех: вызов возвращает 200 или post_id, а не происходит ничего." style="text;html=1;align=left;verticalAlign=middle;fontSize=12;fontStyle=0;strokeColor=none;fillColor=none;" vertex="1" parent="1"><mxGeometry x="80" y="1438" width="1140" height="24" as="geometry" /></mxCell><mxCell id="l10" value="Стену нельзя прочитать обратно тем же ключом — проверить публикацию можно только глазами." style="text;html=1;align=left;verticalAlign=middle;fontSize=12;fontStyle=0;strokeColor=none;fillColor=none;" vertex="1" parent="1"><mxGeometry x="80" y="1464" width="1140" height="24" as="geometry" /></mxCell></root></mxGraphModel></diagram></mxfile>