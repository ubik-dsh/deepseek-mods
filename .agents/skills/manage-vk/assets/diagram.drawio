<mxfile host="dsh" agent="draw-the-vk-flow.py"><diagram id="vk" name="ВК"><mxGraphModel dx="0" dy="0" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="2244" pageHeight="2136" math="0" shadow="0"><root><mxCell id="0" /><mxCell id="1" parent="0" /><mxCell id="head" value="РАБОТА С ВК — что ключ сообщества может и чего нет" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;shadow=1;strokeWidth=2;fillColor=#DAE8FC;strokeColor=#6C8EBF;fontSize=18;fontStyle=1;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="90" y="60" width="2064" height="78" as="geometry" /></mxCell><mxCell id="in" value="ЗАДАЧА В ВК" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;shadow=1;strokeWidth=1;fillColor=#DAE8FC;strokeColor=#6C8EBF;align=left;verticalAlign=middle;spacingLeft=20;spacingTop=10;spacingBottom=10;fontSize=13;" vertex="1" parent="1"><mxGeometry x="90" y="226" width="2064" height="56" as="geometry" /></mxCell><mxCell id="band_order" value="ПОРЯДОК МЫШЛЕНИЯ — сверху вниз" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#F5F5F5;strokeColor=#666666;align=left;verticalAlign=middle;spacingLeft=20;fontStyle=1;fontSize=12;" vertex="1" parent="1"><mxGeometry x="90" y="324" width="460" height="34" as="geometry" /></mxCell><mxCell id="band_can" value="ЧТО ЭТОТ КЛЮЧ МОЖЕТ — измерено, не прочитано в документации" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#F5F5F5;strokeColor=#666666;align=left;verticalAlign=middle;spacingLeft=20;fontStyle=1;fontSize=12;" vertex="1" parent="1"><mxGeometry x="592" y="324" width="760" height="34" as="geometry" /></mxCell><mxCell id="band_cannot" value="ЧЕГО ЭТОТ КЛЮЧ НЕ МОЖЕТ — и это дороже, чем кажется" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#F5F5F5;strokeColor=#666666;align=left;verticalAlign=middle;spacingLeft=20;fontStyle=1;fontSize=12;" vertex="1" parent="1"><mxGeometry x="1394" y="324" width="760" height="34" as="geometry" /></mxCell><mxCell id="o0" value="&lt;b&gt;ГРАНИЦЫ&lt;/b&gt; — что этот ключ вообще может трогать" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;shadow=1;strokeWidth=1;fillColor=#DAE8FC;strokeColor=#6C8EBF;align=left;verticalAlign=middle;spacingLeft=20;spacingTop=10;spacingBottom=10;fontSize=13;" vertex="1" parent="1"><mxGeometry x="90" y="400" width="460" height="56" as="geometry" /></mxCell><mxCell id="o1" value="&lt;b&gt;ФУНКЦИИ&lt;/b&gt; — чем именно, каким методом" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;shadow=1;strokeWidth=1;fillColor=#DAE8FC;strokeColor=#6C8EBF;align=left;verticalAlign=middle;spacingLeft=20;spacingTop=10;spacingBottom=10;fontSize=13;" vertex="1" parent="1"><mxGeometry x="90" y="468" width="460" height="56" as="geometry" /></mxCell><mxCell id="ao1" style="endArrow=classic;html=1;strokeColor=#6C8EBF;strokeWidth=2;rounded=0;edgeStyle=orthogonalEdgeStyle;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="o0" target="o1"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="o2" value="&lt;b&gt;СМЫСЛ&lt;/b&gt; — стоит ли это делать и что будет" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;shadow=1;strokeWidth=1;fillColor=#E1D5E7;strokeColor=#9673A6;align=left;verticalAlign=middle;spacingLeft=20;spacingTop=10;spacingBottom=10;fontSize=13;" vertex="1" parent="1"><mxGeometry x="90" y="536" width="460" height="56" as="geometry" /></mxCell><mxCell id="ao2" style="endArrow=classic;html=1;strokeColor=#9673A6;strokeWidth=2;rounded=0;edgeStyle=orthogonalEdgeStyle;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="o1" target="o2"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="o3" value="&lt;b&gt;ПРОСЬБЫ&lt;/b&gt; — что просил оператор и что из этого вышло" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;shadow=1;strokeWidth=1;fillColor=#E1D5E7;strokeColor=#9673A6;align=left;verticalAlign=middle;spacingLeft=20;spacingTop=10;spacingBottom=10;fontSize=13;" vertex="1" parent="1"><mxGeometry x="90" y="604" width="460" height="56" as="geometry" /></mxCell><mxCell id="ao3" style="endArrow=classic;html=1;strokeColor=#9673A6;strokeWidth=2;rounded=0;edgeStyle=orthogonalEdgeStyle;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="o2" target="o3"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="ao0" style="endArrow=classic;html=1;strokeColor=#6C8EBF;strokeWidth=2;rounded=0;edgeStyle=orthogonalEdgeStyle;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="in" target="o0"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="as0" style="endArrow=classic;html=1;strokeColor=#6C8EBF;strokeWidth=2;rounded=0;edgeStyle=orthogonalEdgeStyle;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="o3" target="s0"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="s0" value="&lt;b&gt;Step 0 — Предполётная проверка — ДО всего остального&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#444444&quot; style=&quot;font-size:11px&quot;&gt;резолвит сообщество и права, ничего не меняя&lt;/font&gt;" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;shadow=1;strokeWidth=1;fillColor=#FFE6CC;strokeColor=#D79B00;align=left;verticalAlign=middle;spacingLeft=20;spacingTop=10;spacingBottom=10;fontSize=13;" vertex="1" parent="1"><mxGeometry x="90" y="714" width="460" height="88" as="geometry" /></mxCell><mxCell id="s1" value="&lt;b&gt;Step 1 — Ключ живёт в окружении и больше нигде&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#444444&quot; style=&quot;font-size:11px&quot;&gt;никогда не печатать, не пересылать, не коммитить&lt;/font&gt;" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;shadow=1;strokeWidth=1;fillColor=#FFE6CC;strokeColor=#D79B00;align=left;verticalAlign=middle;spacingLeft=20;spacingTop=10;spacingBottom=10;fontSize=13;" vertex="1" parent="1"><mxGeometry x="90" y="844" width="460" height="88" as="geometry" /></mxCell><mxCell id="as1" style="endArrow=classic;html=1;strokeColor=#6C8EBF;strokeWidth=2;rounded=0;edgeStyle=orthogonalEdgeStyle;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="s0" target="s1"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="s2" value="&lt;b&gt;Step 2 — Что ключ сообщества может и чего не может — измерено&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#444444&quot; style=&quot;font-size:11px&quot;&gt;смотри колонки справа&lt;/font&gt;" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;shadow=1;strokeWidth=1;fillColor=#FFE6CC;strokeColor=#D79B00;align=left;verticalAlign=middle;spacingLeft=20;spacingTop=10;spacingBottom=10;fontSize=13;" vertex="1" parent="1"><mxGeometry x="90" y="974" width="460" height="88" as="geometry" /></mxCell><mxCell id="as2" style="endArrow=classic;html=1;strokeColor=#6C8EBF;strokeWidth=2;rounded=0;edgeStyle=orthogonalEdgeStyle;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="s1" target="s2"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="s3" value="&lt;b&gt;Step 3 — Ворота подтверждения&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#444444&quot; style=&quot;font-size:11px&quot;&gt;оператор видит текст до публикации&lt;/font&gt;" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;shadow=1;strokeWidth=1;fillColor=#F8CECC;strokeColor=#B85450;align=left;verticalAlign=middle;spacingLeft=20;spacingTop=10;spacingBottom=10;fontSize=13;" vertex="1" parent="1"><mxGeometry x="90" y="1104" width="460" height="88" as="geometry" /></mxCell><mxCell id="as3" style="endArrow=classic;html=1;strokeColor=#6C8EBF;strokeWidth=2;rounded=0;edgeStyle=orthogonalEdgeStyle;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="s2" target="s3"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="s4" value="&lt;b&gt;Step 4 — Опубликовать или отложить&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#444444&quot; style=&quot;font-size:11px&quot;&gt;и подтвердить по post_id и глазами&lt;/font&gt;" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;shadow=1;strokeWidth=1;fillColor=#D5E8D4;strokeColor=#82B366;align=left;verticalAlign=middle;spacingLeft=20;spacingTop=10;spacingBottom=10;fontSize=13;" vertex="1" parent="1"><mxGeometry x="90" y="1234" width="460" height="88" as="geometry" /></mxCell><mxCell id="as4" style="endArrow=classic;html=1;strokeColor=#6C8EBF;strokeWidth=2;rounded=0;edgeStyle=orthogonalEdgeStyle;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="s3" target="s4"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="c0" value="+ wall.post — написать на стену" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;shadow=1;strokeWidth=1;fillColor=#D5E8D4;strokeColor=#82B366;align=left;verticalAlign=middle;spacingLeft=20;spacingTop=10;spacingBottom=10;fontSize=11;" vertex="1" parent="1"><mxGeometry x="592" y="400" width="760" height="56" as="geometry" /></mxCell><mxCell id="c1" value="+ groups.edit — правки сообщества (молча игнорирует лишнее)" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;shadow=1;strokeWidth=1;fillColor=#D5E8D4;strokeColor=#82B366;align=left;verticalAlign=middle;spacingLeft=20;spacingTop=10;spacingBottom=10;fontSize=11;" vertex="1" parent="1"><mxGeometry x="592" y="468" width="760" height="56" as="geometry" /></mxCell><mxCell id="c2" value="+ wall.closeComments — закрыть комментарии" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;shadow=1;strokeWidth=1;fillColor=#D5E8D4;strokeColor=#82B366;align=left;verticalAlign=middle;spacingLeft=20;spacingTop=10;spacingBottom=10;fontSize=11;" vertex="1" parent="1"><mxGeometry x="592" y="536" width="760" height="56" as="geometry" /></mxCell><mxCell id="c3" value="+ groups.getById / getTokenPermissions — кто мы и что нам можно" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;shadow=1;strokeWidth=1;fillColor=#D5E8D4;strokeColor=#82B366;align=left;verticalAlign=middle;spacingLeft=20;spacingTop=10;spacingBottom=10;fontSize=11;" vertex="1" parent="1"><mxGeometry x="592" y="604" width="760" height="56" as="geometry" /></mxCell><mxCell id="c4" value="+ groups.getMembers / getBanned — участники и забаненные" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;shadow=1;strokeWidth=1;fillColor=#D5E8D4;strokeColor=#82B366;align=left;verticalAlign=middle;spacingLeft=20;spacingTop=10;spacingBottom=10;fontSize=11;" vertex="1" parent="1"><mxGeometry x="592" y="672" width="760" height="56" as="geometry" /></mxCell><mxCell id="c5" value="+ groups.getLongPollServer / setLongPollSettings — живая лента" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;shadow=1;strokeWidth=1;fillColor=#D5E8D4;strokeColor=#82B366;align=left;verticalAlign=middle;spacingLeft=20;spacingTop=10;spacingBottom=10;fontSize=11;" vertex="1" parent="1"><mxGeometry x="592" y="740" width="760" height="56" as="geometry" /></mxCell><mxCell id="c6" value="+ groups.addAddress / editAddress / deleteAddress — адреса" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;shadow=1;strokeWidth=1;fillColor=#D5E8D4;strokeColor=#82B366;align=left;verticalAlign=middle;spacingLeft=20;spacingTop=10;spacingBottom=10;fontSize=11;" vertex="1" parent="1"><mxGeometry x="592" y="808" width="760" height="56" as="geometry" /></mxCell><mxCell id="c7" value="+ вложение ДОКУМЕНТА к посту" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;shadow=1;strokeWidth=1;fillColor=#D5E8D4;strokeColor=#82B366;align=left;verticalAlign=middle;spacingLeft=20;spacingTop=10;spacingBottom=10;fontSize=11;" vertex="1" parent="1"><mxGeometry x="592" y="876" width="760" height="56" as="geometry" /></mxCell><mxCell id="n0" value="− ЧИТАТЬ стену: wall.get / getById / getComments — ошибка 27" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;shadow=1;strokeWidth=1;fillColor=#F8CECC;strokeColor=#B85450;align=left;verticalAlign=middle;spacingLeft=20;spacingTop=10;spacingBottom=10;fontSize=11;" vertex="1" parent="1"><mxGeometry x="1394" y="974" width="760" height="56" as="geometry" /></mxCell><mxCell id="n1" value="− УДАЛИТЬ или ИСПРАВИТЬ пост: wall.delete / edit / restore — ошибка 27" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;shadow=1;strokeWidth=1;fillColor=#F8CECC;strokeColor=#B85450;align=left;verticalAlign=middle;spacingLeft=20;spacingTop=10;spacingBottom=10;fontSize=11;" vertex="1" parent="1"><mxGeometry x="1394" y="1042" width="760" height="56" as="geometry" /></mxCell><mxCell id="n2" value="− photos.getWallUploadServer / saveWallPhoto — ошибка 27" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;shadow=1;strokeWidth=1;fillColor=#F8CECC;strokeColor=#B85450;align=left;verticalAlign=middle;spacingLeft=20;spacingTop=10;spacingBottom=10;fontSize=11;" vertex="1" parent="1"><mxGeometry x="1394" y="1110" width="760" height="56" as="geometry" /></mxCell><mxCell id="n3" value="− приложить ФОТО к посту — вызов проходит, вложение пропадает" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;shadow=1;strokeWidth=1;fillColor=#F8CECC;strokeColor=#B85450;align=left;verticalAlign=middle;spacingLeft=20;spacingTop=10;spacingBottom=10;fontSize=11;" vertex="1" parent="1"><mxGeometry x="1394" y="1178" width="760" height="56" as="geometry" /></mxCell><mxCell id="n4" value="− groups.create / editManager / removeUser / search — нужен ключ пользователя" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;shadow=1;strokeWidth=1;fillColor=#F8CECC;strokeColor=#B85450;align=left;verticalAlign=middle;spacingLeft=20;spacingTop=10;spacingBottom=10;fontSize=11;" vertex="1" parent="1"><mxGeometry x="1394" y="1246" width="760" height="56" as="geometry" /></mxCell><mxCell id="n5" value="− groups.delete — такого метода НЕ СУЩЕСТВУЕТ ВООБЩЕ" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;shadow=1;strokeWidth=1;fillColor=#F8CECC;strokeColor=#B85450;align=left;verticalAlign=middle;spacingLeft=20;spacingTop=10;spacingBottom=10;fontSize=11;" vertex="1" parent="1"><mxGeometry x="1394" y="1314" width="760" height="56" as="geometry" /></mxCell><mxCell id="legend" value="&lt;b&gt;ЧТО ЭТО ЗА СХЕМА&lt;/b&gt;&lt;br&gt;Работа с ВК: что ключ сообщества может и чего не может, и в каком порядке идёт публикация.&lt;br&gt;Это НЕ структура файлов (family.drawio), НЕ ворота (gates.drawio) и НЕ суд (hearing.drawio).&lt;br&gt;&amp;nbsp;&lt;br&gt;&lt;b&gt;КАК ЧИТАТЬ&lt;/b&gt;&lt;br&gt;Слева сверху вниз — порядок мышления и шаги публикации.&lt;br&gt;Зелёная колонка — что получается. Красная — что не получается, и это важнее.&lt;br&gt;&amp;nbsp;&lt;br&gt;&lt;b&gt;ПОЧЕМУ КРАСНАЯ КОЛОНКА ГЛАВНАЯ&lt;/b&gt;&lt;br&gt;Отказы здесь приходят как успех: вызов возвращает 200 или post_id, а не происходит ничего.&lt;br&gt;Стену нельзя прочитать обратно тем же ключом — проверить публикацию можно только глазами.&lt;br&gt;&amp;nbsp;" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;shadow=1;strokeWidth=1;fillColor=#FFFFFF;strokeColor=#B3B3B3;align=left;verticalAlign=top;spacingLeft=20;spacingTop=10;fontSize=11;" vertex="1" parent="1"><mxGeometry x="90" y="1412" width="2064" height="248" as="geometry" /></mxCell><mxCell id="band_traps" value="ЛОВУШКИ, КОТОРЫЕ СТОЯТ ДОРОЖЕ ВСЕГО" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#F5F5F5;strokeColor=#666666;align=left;verticalAlign=middle;spacingLeft=20;fontStyle=1;fontSize=12;" vertex="1" parent="1"><mxGeometry x="90" y="1702" width="2064" height="34" as="geometry" /></mxCell><mxCell id="t0" value="Ошибки приходят НЕ как ошибки HTTP. VK отвечает 200, а отказ лежит в теле." style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;shadow=1;strokeWidth=1;fillColor=#FFE6CC;strokeColor=#D79B00;align=left;verticalAlign=middle;spacingLeft=20;spacingTop=10;spacingBottom=10;fontSize=11;" vertex="1" parent="1"><mxGeometry x="90" y="1748" width="2064" height="56" as="geometry" /></mxCell><mxCell id="t1" value="err 100 — метод есть и вызывается, но аргументы не те. err 27 — метод есть, токен чужой." style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;shadow=1;strokeWidth=1;fillColor=#FFE6CC;strokeColor=#D79B00;align=left;verticalAlign=middle;spacingLeft=20;spacingTop=10;spacingBottom=10;fontSize=11;" vertex="1" parent="1"><mxGeometry x="90" y="1816" width="2064" height="56" as="geometry" /></mxCell><mxCell id="t2" value="err 3 — такого метода нет. Это надо отправлять первым, как контроль." style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;shadow=1;strokeWidth=1;fillColor=#FFE6CC;strokeColor=#D79B00;align=left;verticalAlign=middle;spacingLeft=20;spacingTop=10;spacingBottom=10;fontSize=11;" vertex="1" parent="1"><mxGeometry x="90" y="1884" width="2064" height="56" as="geometry" /></mxCell><mxCell id="t3" value="groups.edit возвращает 1 на ЛЮБОЙ неизвестный параметр — «принято» не значит «применено»." style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;shadow=1;strokeWidth=1;fillColor=#FFE6CC;strokeColor=#D79B00;align=left;verticalAlign=middle;spacingLeft=20;spacingTop=10;spacingBottom=10;fontSize=11;" vertex="1" parent="1"><mxGeometry x="90" y="1952" width="2064" height="56" as="geometry" /></mxCell><mxCell id="t4" value="Нет безопасной пробы записи ключом сообщества: любая запись что-то меняет." style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;shadow=1;strokeWidth=1;fillColor=#FFE6CC;strokeColor=#D79B00;align=left;verticalAlign=middle;spacingLeft=20;spacingTop=10;spacingBottom=10;fontSize=11;" vertex="1" parent="1"><mxGeometry x="90" y="2020" width="2064" height="56" as="geometry" /></mxCell></root></mxGraphModel></diagram></mxfile>