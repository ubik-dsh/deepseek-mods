<mxfile host="dsh" agent="draw-a-skill-flow.py"><diagram id="check-hardware" name="Проверка железа машины"><mxGraphModel dx="0" dy="0" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1400" pageHeight="1400" math="0" shadow="0"><root><mxCell id="0" /><mxCell id="1" parent="0" /><mxCell id="head" value="Проверка железа машины" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#DAE8FC;strokeColor=#6C8EBF;fontSize=16;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="70" y="30" width="560" height="48" as="geometry" /></mxCell><mxCell id="s0" value="&lt;b&gt;Прочитать до того, как трогать&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#444444&quot; style=&quot;font-size:11px&quot;&gt;диагностика остаётся только для чтения, пока нет улики&lt;/font&gt;&lt;br&gt;&lt;font color=&quot;#999999&quot; style=&quot;font-size:9px&quot;&gt;Step 0 — read before you touch&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#DAE8FC;strokeColor=#6C8EBF;align=left;spacingLeft=10;fontSize=12;" vertex="1" parent="1"><mxGeometry x="70" y="110" width="560" height="72" as="geometry" /></mxCell><mxCell id="a0" style="endArrow=classic;html=1;strokeColor=#6C8EBF;strokeWidth=2;rounded=0;edgeStyle=orthogonalEdgeStyle;" edge="1" parent="1" source="head" target="s0"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="s1" value="&lt;b&gt;Снять показания&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#444444&quot; style=&quot;font-size:11px&quot;&gt;команды, которые работают, и те, что тихо возвращают пустоту&lt;/font&gt;&lt;br&gt;&lt;font color=&quot;#999999&quot; style=&quot;font-size:9px&quot;&gt;Step 1 — take the readings&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFE6CC;strokeColor=#D79B00;align=left;spacingLeft=10;fontSize=12;" vertex="1" parent="1"><mxGeometry x="70" y="202" width="560" height="72" as="geometry" /></mxCell><mxCell id="a1" style="endArrow=classic;html=1;strokeColor=#6C8EBF;strokeWidth=2;rounded=0;edgeStyle=orthogonalEdgeStyle;" edge="1" parent="1" source="s0" target="s1"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="s2" value="&lt;b&gt;Отделить неисправное от нечитаемого&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#444444&quot; style=&quot;font-size:11px&quot;&gt;диск со статусом Healthy мог вообще не проверяться&lt;/font&gt;&lt;br&gt;&lt;font color=&quot;#999999&quot; style=&quot;font-size:9px&quot;&gt;Step 2 — separate what is wrong from what is unreadable&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E1D5E7;strokeColor=#9673A6;align=left;spacingLeft=10;fontSize=12;" vertex="1" parent="1"><mxGeometry x="70" y="294" width="560" height="72" as="geometry" /></mxCell><mxCell id="a2" style="endArrow=classic;html=1;strokeColor=#6C8EBF;strokeWidth=2;rounded=0;edgeStyle=orthogonalEdgeStyle;" edge="1" parent="1" source="s1" target="s2"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="s3" value="&lt;b&gt;Симптом, улика, гипотеза, проверка&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#444444&quot; style=&quot;font-size:11px&quot;&gt;порядок, при котором догадка не выдаётся за диагноз&lt;/font&gt;&lt;br&gt;&lt;font color=&quot;#999999&quot; style=&quot;font-size:9px&quot;&gt;Step 3 — symptom, evidence, hypothesis, test&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#D5E8D4;strokeColor=#82B366;align=left;spacingLeft=10;fontSize=12;" vertex="1" parent="1"><mxGeometry x="70" y="386" width="560" height="72" as="geometry" /></mxCell><mxCell id="a3" style="endArrow=classic;html=1;strokeColor=#6C8EBF;strokeWidth=2;rounded=0;edgeStyle=orthogonalEdgeStyle;" edge="1" parent="1" source="s2" target="s3"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="s4" value="&lt;b&gt;Лестница обострения&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#444444&quot; style=&quot;font-size:11px&quot;&gt;что делать, когда чтения не хватает&lt;/font&gt;&lt;br&gt;&lt;font color=&quot;#999999&quot; style=&quot;font-size:9px&quot;&gt;Step 4 — the escalation ladder&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F5F5F5;strokeColor=#666666;align=left;spacingLeft=10;fontSize=12;" vertex="1" parent="1"><mxGeometry x="70" y="478" width="560" height="72" as="geometry" /></mxCell><mxCell id="a4" style="endArrow=classic;html=1;strokeColor=#6C8EBF;strokeWidth=2;rounded=0;edgeStyle=orthogonalEdgeStyle;" edge="1" parent="1" source="s3" target="s4"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="s5" value="&lt;b&gt;Показания, которые обманывают&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#444444&quot; style=&quot;font-size:11px&quot;&gt;память по слотам, а не по объёму; две ёмкости батареи&lt;/font&gt;&lt;br&gt;&lt;font color=&quot;#999999&quot; style=&quot;font-size:9px&quot;&gt;The readings that fool people&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F5F5F5;strokeColor=#666666;align=left;spacingLeft=10;fontSize=12;" vertex="1" parent="1"><mxGeometry x="70" y="570" width="560" height="72" as="geometry" /></mxCell><mxCell id="a5" style="endArrow=classic;html=1;strokeColor=#6C8EBF;strokeWidth=2;rounded=0;edgeStyle=orthogonalEdgeStyle;" edge="1" parent="1" source="s4" target="s5"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="l0" value="ЧТО ЭТО ЗА СХЕМА" style="text;html=1;align=left;verticalAlign=middle;fontSize=12;fontStyle=1;strokeColor=none;fillColor=none;" vertex="1" parent="1"><mxGeometry x="700" y="110" width="640" height="26" as="geometry" /></mxCell><mxCell id="l1" value="Порядок работы скилла check-hardware: шаги в том порядке, в каком их надо делать." style="text;html=1;align=left;verticalAlign=middle;fontSize=12;fontStyle=0;strokeColor=none;fillColor=none;" vertex="1" parent="1"><mxGeometry x="700" y="140" width="640" height="26" as="geometry" /></mxCell><mxCell id="l2" value="Это НЕ структура файлов (family.drawio) и НЕ ворота регламента (gates.drawio)." style="text;html=1;align=left;verticalAlign=middle;fontSize=12;fontStyle=0;strokeColor=none;fillColor=none;" vertex="1" parent="1"><mxGeometry x="700" y="170" width="640" height="26" as="geometry" /></mxCell><mxCell id="l3" value="" style="text;html=1;align=left;verticalAlign=middle;fontSize=12;fontStyle=0;strokeColor=none;fillColor=none;" vertex="1" parent="1"><mxGeometry x="700" y="200" width="640" height="26" as="geometry" /></mxCell><mxCell id="l4" value="КАК ЧИТАТЬ" style="text;html=1;align=left;verticalAlign=middle;fontSize=12;fontStyle=1;strokeColor=none;fillColor=none;" vertex="1" parent="1"><mxGeometry x="700" y="230" width="640" height="26" as="geometry" /></mxCell><mxCell id="l5" value="Синяя рамка сверху — сам скилл. Стрелка вниз — следующий шаг." style="text;html=1;align=left;verticalAlign=middle;fontSize=12;fontStyle=0;strokeColor=none;fillColor=none;" vertex="1" parent="1"><mxGeometry x="700" y="260" width="640" height="26" as="geometry" /></mxCell><mxCell id="l6" value="Заголовок по-русски, под ним зачем этот шаг, внизу мелко — исходный заголовок из файла." style="text;html=1;align=left;verticalAlign=middle;fontSize=12;fontStyle=0;strokeColor=none;fillColor=none;" vertex="1" parent="1"><mxGeometry x="700" y="290" width="640" height="26" as="geometry" /></mxCell><mxCell id="l7" value="" style="text;html=1;align=left;verticalAlign=middle;fontSize=12;fontStyle=0;strokeColor=none;fillColor=none;" vertex="1" parent="1"><mxGeometry x="700" y="320" width="640" height="26" as="geometry" /></mxCell><mxCell id="l8" value="О ЧЁМ ЭТОТ СКИЛЛ" style="text;html=1;align=left;verticalAlign=middle;fontSize=12;fontStyle=1;strokeColor=none;fillColor=none;" vertex="1" parent="1"><mxGeometry x="700" y="350" width="640" height="26" as="geometry" /></mxCell><mxCell id="l9" value="Прочитать, что железо о себе сообщает, и отличить больную деталь от нечитаемой." style="text;html=1;align=left;verticalAlign=middle;fontSize=12;fontStyle=0;strokeColor=none;fillColor=none;" vertex="1" parent="1"><mxGeometry x="700" y="380" width="640" height="26" as="geometry" /></mxCell></root></mxGraphModel></diagram></mxfile>