<mxfile host="dsh" agent="draw-a-skill-flow.py"><diagram id="check-hardware" name="Проверка железа машины"><mxGraphModel dx="0" dy="0" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1582" pageHeight="1020" math="0" shadow="0"><root><mxCell id="0" /><mxCell id="1" parent="0" /><mxCell id="head" value="Проверка железа машины" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;shadow=1;strokeWidth=2;fillColor=#DAE8FC;strokeColor=#6C8EBF;fontSize=18;fontStyle=1;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="90" y="60" width="640" height="78" as="geometry" /></mxCell><mxCell id="s0" value="&lt;b&gt;Прочитать до того, как трогать&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#444444&quot; style=&quot;font-size:11px&quot;&gt;диагностика остаётся только для чтения, пока нет улики&lt;/font&gt;&lt;br&gt;&lt;font color=&quot;#999999&quot; style=&quot;font-size:9px&quot;&gt;Step 0 — read before you touch&lt;/font&gt;" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;shadow=1;strokeWidth=1;fillColor=#DAE8FC;strokeColor=#6C8EBF;align=left;verticalAlign=middle;spacingLeft=20;spacingTop=10;spacingBottom=10;fontSize=13;" vertex="1" parent="1"><mxGeometry x="90" y="180" width="640" height="88" as="geometry" /></mxCell><mxCell id="a0" style="endArrow=classic;html=1;strokeColor=#6C8EBF;strokeWidth=2;rounded=0;edgeStyle=orthogonalEdgeStyle;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="head" target="s0"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="s1" value="&lt;b&gt;Снять показания&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#444444&quot; style=&quot;font-size:11px&quot;&gt;команды, которые работают, и те, что тихо возвращают пустоту&lt;/font&gt;&lt;br&gt;&lt;font color=&quot;#999999&quot; style=&quot;font-size:9px&quot;&gt;Step 1 — take the readings&lt;/font&gt;" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;shadow=1;strokeWidth=1;fillColor=#FFE6CC;strokeColor=#D79B00;align=left;verticalAlign=middle;spacingLeft=20;spacingTop=10;spacingBottom=10;fontSize=13;" vertex="1" parent="1"><mxGeometry x="90" y="310" width="640" height="88" as="geometry" /></mxCell><mxCell id="a1" style="endArrow=classic;html=1;strokeColor=#6C8EBF;strokeWidth=2;rounded=0;edgeStyle=orthogonalEdgeStyle;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="s0" target="s1"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="s2" value="&lt;b&gt;Отделить неисправное от нечитаемого&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#444444&quot; style=&quot;font-size:11px&quot;&gt;диск со статусом Healthy мог вообще не проверяться&lt;/font&gt;&lt;br&gt;&lt;font color=&quot;#999999&quot; style=&quot;font-size:9px&quot;&gt;Step 2 — separate what is wrong from what is unreadable&lt;/font&gt;" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;shadow=1;strokeWidth=1;fillColor=#E1D5E7;strokeColor=#9673A6;align=left;verticalAlign=middle;spacingLeft=20;spacingTop=10;spacingBottom=10;fontSize=13;" vertex="1" parent="1"><mxGeometry x="90" y="440" width="640" height="88" as="geometry" /></mxCell><mxCell id="a2" style="endArrow=classic;html=1;strokeColor=#6C8EBF;strokeWidth=2;rounded=0;edgeStyle=orthogonalEdgeStyle;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="s1" target="s2"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="s3" value="&lt;b&gt;Симптом, улика, гипотеза, проверка&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#444444&quot; style=&quot;font-size:11px&quot;&gt;порядок, при котором догадка не выдаётся за диагноз&lt;/font&gt;&lt;br&gt;&lt;font color=&quot;#999999&quot; style=&quot;font-size:9px&quot;&gt;Step 3 — symptom, evidence, hypothesis, test&lt;/font&gt;" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;shadow=1;strokeWidth=1;fillColor=#D5E8D4;strokeColor=#82B366;align=left;verticalAlign=middle;spacingLeft=20;spacingTop=10;spacingBottom=10;fontSize=13;" vertex="1" parent="1"><mxGeometry x="90" y="570" width="640" height="88" as="geometry" /></mxCell><mxCell id="a3" style="endArrow=classic;html=1;strokeColor=#6C8EBF;strokeWidth=2;rounded=0;edgeStyle=orthogonalEdgeStyle;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="s2" target="s3"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="s4" value="&lt;b&gt;Лестница обострения&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#444444&quot; style=&quot;font-size:11px&quot;&gt;что делать, когда чтения не хватает&lt;/font&gt;&lt;br&gt;&lt;font color=&quot;#999999&quot; style=&quot;font-size:9px&quot;&gt;Step 4 — the escalation ladder&lt;/font&gt;" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;shadow=1;strokeWidth=1;fillColor=#F5F5F5;strokeColor=#666666;align=left;verticalAlign=middle;spacingLeft=20;spacingTop=10;spacingBottom=10;fontSize=13;" vertex="1" parent="1"><mxGeometry x="90" y="700" width="640" height="88" as="geometry" /></mxCell><mxCell id="a4" style="endArrow=classic;html=1;strokeColor=#6C8EBF;strokeWidth=2;rounded=0;edgeStyle=orthogonalEdgeStyle;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="s3" target="s4"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="s5" value="&lt;b&gt;Показания, которые обманывают&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#444444&quot; style=&quot;font-size:11px&quot;&gt;память по слотам, а не по объёму; две ёмкости батареи&lt;/font&gt;&lt;br&gt;&lt;font color=&quot;#999999&quot; style=&quot;font-size:9px&quot;&gt;The readings that fool people&lt;/font&gt;" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;shadow=1;strokeWidth=1;fillColor=#F5F5F5;strokeColor=#666666;align=left;verticalAlign=middle;spacingLeft=20;spacingTop=10;spacingBottom=10;fontSize=13;" vertex="1" parent="1"><mxGeometry x="90" y="830" width="640" height="88" as="geometry" /></mxCell><mxCell id="a5" style="endArrow=classic;html=1;strokeColor=#6C8EBF;strokeWidth=2;rounded=0;edgeStyle=orthogonalEdgeStyle;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="s4" target="s5"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="legend" value="&lt;b&gt;ЧТО ЭТО ЗА СХЕМА&lt;/b&gt;&lt;br&gt;Порядок работы скилла check-hardware: шаги в том порядке, в каком их надо делать.&lt;br&gt;Это НЕ структура файлов (family.drawio) и НЕ ворота регламента (gates.drawio).&lt;br&gt;&amp;nbsp;&lt;br&gt;&lt;b&gt;КАК ЧИТАТЬ&lt;/b&gt;&lt;br&gt;Синяя рамка сверху — сам скилл. Стрелка вниз — следующий шаг.&lt;br&gt;Заголовок по-русски, под ним зачем этот шаг, внизу мелко — исходный заголовок.&lt;br&gt;&amp;nbsp;&lt;br&gt;&lt;b&gt;О ЧЁМ ЭТОТ СКИЛЛ&lt;/b&gt;&lt;br&gt;Прочитать, что железо о себе сообщает, и отличить больную деталь от нечитаемой.&lt;br&gt;&amp;nbsp;" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;shadow=1;strokeWidth=1;fillColor=#FFFFFF;strokeColor=#B3B3B3;align=left;verticalAlign=top;spacingLeft=20;spacingTop=10;fontSize=11;" vertex="1" parent="1"><mxGeometry x="832" y="60" width="660" height="226" as="geometry" /></mxCell></root></mxGraphModel></diagram></mxfile>