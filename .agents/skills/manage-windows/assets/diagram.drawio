<mxfile host="dsh" agent="draw-a-skill-flow.py"><diagram id="manage-windows" name="Работа с Windows"><mxGraphModel dx="0" dy="0" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1582" pageHeight="1280" math="0" shadow="0"><root><mxCell id="0" /><mxCell id="1" parent="0" /><mxCell id="head" value="Работа с Windows" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;shadow=1;strokeWidth=2;fillColor=#DAE8FC;strokeColor=#6C8EBF;fontSize=18;fontStyle=1;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="90" y="60" width="640" height="78" as="geometry" /></mxCell><mxCell id="s0" value="&lt;b&gt;Какой канал — до всего остального&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#444444&quot; style=&quot;font-size:11px&quot;&gt;сначала выбрать способ дотянуться&lt;/font&gt;&lt;br&gt;&lt;font color=&quot;#999999&quot; style=&quot;font-size:9px&quot;&gt;Step 0 — which channel, before any of this&lt;/font&gt;" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;shadow=1;strokeWidth=1;fillColor=#DAE8FC;strokeColor=#6C8EBF;align=left;verticalAlign=middle;spacingLeft=20;spacingTop=10;spacingBottom=10;fontSize=13;" vertex="1" parent="1"><mxGeometry x="90" y="180" width="640" height="88" as="geometry" /></mxCell><mxCell id="a0" style="endArrow=classic;html=1;strokeColor=#6C8EBF;strokeWidth=2;rounded=0;edgeStyle=orthogonalEdgeStyle;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="head" target="s0"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="s1" value="&lt;b&gt;PowerShell — основа, и у неё есть ловушки&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#444444&quot; style=&quot;font-size:11px&quot;&gt;кодировки, JSON, который режется без ошибки&lt;/font&gt;&lt;br&gt;&lt;font color=&quot;#999999&quot; style=&quot;font-size:9px&quot;&gt;Step 1 — PowerShell is the substrate, and it has traps&lt;/font&gt;" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;shadow=1;strokeWidth=1;fillColor=#FFE6CC;strokeColor=#D79B00;align=left;verticalAlign=middle;spacingLeft=20;spacingTop=10;spacingBottom=10;fontSize=13;" vertex="1" parent="1"><mxGeometry x="90" y="310" width="640" height="88" as="geometry" /></mxCell><mxCell id="a1" style="endArrow=classic;html=1;strokeColor=#6C8EBF;strokeWidth=2;rounded=0;edgeStyle=orthogonalEdgeStyle;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="s0" target="s1"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="s2" value="&lt;b&gt;Ввод доходит до приложения только правильным вызовом&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#444444&quot; style=&quot;font-size:11px&quot;&gt;лестница ввода для XAML и WinUI&lt;/font&gt;&lt;br&gt;&lt;font color=&quot;#999999&quot; style=&quot;font-size:9px&quot;&gt;Step 2 — input only reaches an application through the right call&lt;/font&gt;" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;shadow=1;strokeWidth=1;fillColor=#E1D5E7;strokeColor=#9673A6;align=left;verticalAlign=middle;spacingLeft=20;spacingTop=10;spacingBottom=10;fontSize=13;" vertex="1" parent="1"><mxGeometry x="90" y="440" width="640" height="88" as="geometry" /></mxCell><mxCell id="a2" style="endArrow=classic;html=1;strokeColor=#6C8EBF;strokeWidth=2;rounded=0;edgeStyle=orthogonalEdgeStyle;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="s1" target="s2"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="s3" value="&lt;b&gt;Проверить цель ДО нажатия&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#444444&quot; style=&quot;font-size:11px&quot;&gt;фокус, заголовок, координаты — иначе нажатие уходит не туда&lt;/font&gt;&lt;br&gt;&lt;font color=&quot;#999999&quot; style=&quot;font-size:9px&quot;&gt;Step 3 — verify before you press&lt;/font&gt;" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;shadow=1;strokeWidth=1;fillColor=#D5E8D4;strokeColor=#82B366;align=left;verticalAlign=middle;spacingLeft=20;spacingTop=10;spacingBottom=10;fontSize=13;" vertex="1" parent="1"><mxGeometry x="90" y="570" width="640" height="88" as="geometry" /></mxCell><mxCell id="a3" style="endArrow=classic;html=1;strokeColor=#6C8EBF;strokeWidth=2;rounded=0;edgeStyle=orthogonalEdgeStyle;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="s2" target="s3"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="s4" value="&lt;b&gt;Мерить, а не предполагать&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#444444&quot; style=&quot;font-size:11px&quot;&gt;окно, DPI, масштаб&lt;/font&gt;&lt;br&gt;&lt;font color=&quot;#999999&quot; style=&quot;font-size:9px&quot;&gt;Step 4 — measure, do not assume&lt;/font&gt;" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;shadow=1;strokeWidth=1;fillColor=#F5F5F5;strokeColor=#666666;align=left;verticalAlign=middle;spacingLeft=20;spacingTop=10;spacingBottom=10;fontSize=13;" vertex="1" parent="1"><mxGeometry x="90" y="700" width="640" height="88" as="geometry" /></mxCell><mxCell id="a4" style="endArrow=classic;html=1;strokeColor=#6C8EBF;strokeWidth=2;rounded=0;edgeStyle=orthogonalEdgeStyle;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="s3" target="s4"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="s5" value="&lt;b&gt;Повышение прав и что делать вместо него&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#444444&quot; style=&quot;font-size:11px&quot;&gt;UAC не обходится, его обходят&lt;/font&gt;&lt;br&gt;&lt;font color=&quot;#999999&quot; style=&quot;font-size:9px&quot;&gt;Step 5 — elevation, and what to do instead&lt;/font&gt;" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;shadow=1;strokeWidth=1;fillColor=#F5F5F5;strokeColor=#666666;align=left;verticalAlign=middle;spacingLeft=20;spacingTop=10;spacingBottom=10;fontSize=13;" vertex="1" parent="1"><mxGeometry x="90" y="830" width="640" height="88" as="geometry" /></mxCell><mxCell id="a5" style="endArrow=classic;html=1;strokeColor=#6C8EBF;strokeWidth=2;rounded=0;edgeStyle=orthogonalEdgeStyle;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="s4" target="s5"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="s6" value="&lt;b&gt;Куда класть файлы и чего не трогать&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#444444&quot; style=&quot;font-size:11px&quot;&gt;и CP1251 при чтении .ps1 без BOM&lt;/font&gt;&lt;br&gt;&lt;font color=&quot;#999999&quot; style=&quot;font-size:9px&quot;&gt;Step 6 — where files go, and what not to touch&lt;/font&gt;" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;shadow=1;strokeWidth=1;fillColor=#F5F5F5;strokeColor=#666666;align=left;verticalAlign=middle;spacingLeft=20;spacingTop=10;spacingBottom=10;fontSize=13;" vertex="1" parent="1"><mxGeometry x="90" y="960" width="640" height="88" as="geometry" /></mxCell><mxCell id="a6" style="endArrow=classic;html=1;strokeColor=#6C8EBF;strokeWidth=2;rounded=0;edgeStyle=orthogonalEdgeStyle;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="s5" target="s6"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="s7" value="&lt;b&gt;Отказы, все наблюдавшиеся&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#444444&quot; style=&quot;font-size:11px&quot;&gt;каждый видели своими глазами&lt;/font&gt;&lt;br&gt;&lt;font color=&quot;#999999&quot; style=&quot;font-size:9px&quot;&gt;Failure modes, all of them observed&lt;/font&gt;" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;shadow=1;strokeWidth=1;fillColor=#F5F5F5;strokeColor=#666666;align=left;verticalAlign=middle;spacingLeft=20;spacingTop=10;spacingBottom=10;fontSize=13;" vertex="1" parent="1"><mxGeometry x="90" y="1090" width="640" height="88" as="geometry" /></mxCell><mxCell id="a7" style="endArrow=classic;html=1;strokeColor=#6C8EBF;strokeWidth=2;rounded=0;edgeStyle=orthogonalEdgeStyle;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="s6" target="s7"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="legend" value="&lt;b&gt;ЧТО ЭТО ЗА СХЕМА&lt;/b&gt;&lt;br&gt;Порядок работы скилла manage-windows: шаги в том порядке, в каком их надо делать.&lt;br&gt;Это НЕ структура файлов (family.drawio) и НЕ ворота регламента (gates.drawio).&lt;br&gt;&amp;nbsp;&lt;br&gt;&lt;b&gt;ЦВЕТ РАМОК — ЧЕРЕДОВАНИЕ, А НЕ ЗНАЧЕНИЕ&lt;/b&gt;&lt;br&gt;Пять цветов идут по кругу по номеру шага. Они не значат ничего: ни важности,&lt;br&gt;ни очереди, ни типа. Это полосатость — чтобы глаз не терял строку в длинном&lt;br&gt;списке, как в таблице с чередующимися строками.&lt;br&gt;Если у шагов появится настоящий признак — обязательный, опасный, ворота —&lt;br&gt;цвет надо будет отдать ЕМУ, а не номеру. Пока такого признака нет.&lt;br&gt;&amp;nbsp;&lt;br&gt;&lt;b&gt;КАК ЧИТАТЬ&lt;/b&gt;&lt;br&gt;Синяя рамка сверху — сам скилл. Стрелка вниз — следующий шаг.&lt;br&gt;Заголовок по-русски, под ним зачем этот шаг, внизу мелко — исходный заголовок.&lt;br&gt;&amp;nbsp;&lt;br&gt;&lt;b&gt;О ЧЁМ ЭТОТ СКИЛЛ&lt;/b&gt;&lt;br&gt;Скриптовать Windows так, чтобы ничего не отказывало молча.&lt;br&gt;&amp;nbsp;" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;shadow=1;strokeWidth=1;fillColor=#FFFFFF;strokeColor=#B3B3B3;align=left;verticalAlign=top;spacingLeft=20;spacingTop=10;fontSize=11;" vertex="1" parent="1"><mxGeometry x="832" y="60" width="660" height="358" as="geometry" /></mxCell></root></mxGraphModel></diagram></mxfile>